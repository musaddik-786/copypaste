-- 1. Draft FNOL created by Voice Text Intake Agent
SELECT fnol_number, policy_number, loss_type, cause_of_loss, vehicle_make, vehicle_model, status
FROM motor_fnol_submissions
WHERE policy_number IN ('POL-1001','POL-1002','POL-1003')
ORDER BY created_at DESC;

-- 2. Claim record created on FNOL submission
SELECT claim_number, policy_number, loss_type, severity, status, filed_at
FROM claims
WHERE policy_number IN ('POL-1001','POL-1002','POL-1003')
ORDER BY filed_at DESC;

-- 3. Coverage result written by Verification Agent
SELECT claim_number, policy_number, coverage_verdict, exclusion_triggered,
       net_payable, coverage_notes, verified_at
FROM motor_coverage_verification_results
ORDER BY verified_at DESC;

-- 4. Policy still has remaining coverage limit (after payment recording)
SELECT policy_number, coverage_limit, remaining_coverage_limit, exclusions
FROM motor_policy_details
WHERE policy_number IN ('POL-1001','POL-1002','POL-1003');
