-- 1. New FNOL record in motor_fnol_submissions
SELECT fnol_number, policy_number, loss_type, cause_of_loss,
       vehicle_make, vehicle_model, registration_number, severity, status, created_at
FROM motor_fnol_submissions
WHERE policy_number = 'POL-1002'
ORDER BY created_at DESC LIMIT 3;

-- 2. New claim record in claims table
SELECT claim_number, policy_number, loss_type, severity, status, filed_at
FROM claims
WHERE policy_number = 'POL-1002'
ORDER BY filed_at DESC LIMIT 3;

-- 3. Confirm vehicle was auto-populated (registration MH-02-CD-xxxx)
SELECT fnol_number, vehicle_make, vehicle_model, vehicle_year, registration_number
FROM motor_fnol_submissions
WHERE policy_number = 'POL-1002'
ORDER BY created_at DESC LIMIT 1;
