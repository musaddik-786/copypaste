  "rules": [
    {
      "id": "UP-CAR-01",
      "name": "Upgrade to Full Comprehensive",
      "type": "UPSELL",
      "lob": "CAR",
      "status": "ACTIVE",
      "product_code": "CAR_COV_FULL",
      "priority_tier": "P2",
      "sequence": 10,
      "exclusion_group": "CAR_COVERAGE",
      "risk_class": "MOTOR_UPGRADE",
      "required_facts": [
        "policy.coverage_level",
        "vehicle.market_value",
        "vehicle.age_years",
        "claims.claims_12m",
        "claims.claims_36m",
        "claims.at_fault_24m"
      ],
      "when": {
        "and": [
          {
            "in": [
              {
                "var": "policy.coverage_level"
              },
              [
                "TPL",
                "PARTIAL"
              ]
            ]
          },
          {
            ">=": [
              {
                "var": "vehicle.market_value"
              },
              {
                "var": "params.full_comp_min_vehicle_value"
              }
            ]
          },
          {
            "<=": [
              {
                "var": "vehicle.age_years"
              },
              {
                "var": "params.full_comp_max_vehicle_age"
              }
            ]
          },
          {
            "==": [
              {
                "var": "claims.claims_12m"
              },
              0
            ]
          },
          {
            "<=": [
              {
                "var": "claims.claims_36m"
              },
              {
                "var": "params.full_comp_max_claims_36m"
              }
            ]
          }
        ]
      },
      "source_refs": [
        "BRD UP-CAR-01",
        "BRD UP-CAR-02",
        "RULES UP-CAR-02"
      ]
    },
