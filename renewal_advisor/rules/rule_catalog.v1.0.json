      "source_refs": [
        "RULES BR-06",
        "BAC-08"
      ]
    },
    {
      "order": 8,
      "id": "PR-01",
      "name": "Verified incremental pricing",
      "outcome": "DISQUALIFIED_NO_VERIFIED_PRICE",
