      ]
    },
    {
      "order": 6,
      "id": "QUAL",
      "name": "Opportunity qualification",
      "outcome": "NOT_TRIGGERED"
    },
    {
      "order": 7,
      "id": "EL-04",
      "name": "Target market (IDD POG)",
