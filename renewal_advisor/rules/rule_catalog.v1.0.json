  "ranking": {
    "order_by": [
      "priority_tier ASC",
      "bundle_saving_annual DESC",
      "sequence ASC",
      "rule_id ASC"
    ],
    "max_primary": 1,
    "max_alternative": 1,
    "one_per_exclusion_group": true,
    "source": "BRD BR-08, BR-09; BAC-09",
    "decision": "D-09"
  },
  "window_rule": {
    "id": "W-01",
    "name": "Renewal quote trigger & operational window",
    "source_refs": [
      "BRD BR-01",
      "BAC-01",
      "BAC-02"
    ],
    "when": {
      "and": [
        {
          "==": [
            {
              "var": "quote.status"
            },
            "QUOTED"
          ]
        },
        {
          "==": [
            {
              "var": "quote.letter_dispatched"
            },
            false
          ]
        },
        {
          ">=": [
            {
              "var": "quote.days_to_letter_due"
            },
            0
          ]
        }
      ]
    },
    "outcome_if_false": "NOT_TRIGGERED"
  },
  "gatekeepers": [
    {
      "id": "GK-01",
      "name": "Advisory consent verification",
      "status": "ACTIVE",
      "suppress_when": {
        "!=": [
          {
            "var": "consent.advisory_renewal"
          },
          "GRANTED"
        ]
      },
      "required_facts": [
        "consent.advisory_renewal"
      ],
      "reason_code": "CONSENT_NOT_GRANTED",
      "source_refs": [
        "BRD BR-07",
        "RULES BR-01"
      ],
      "regulatory_refs": [
        "GDPR-ART-6",
        "GDPR-ART-7",
        "GDPR-ART-21",
        "UWG-7"
      ]
    },
    {
      "id": "GK-02",
      "name": "Account standing & arrears",
      "status": "ACTIVE",
      "suppress_when": {
        "!=": [
          {
            "var": "account.payment_status"
          },
          "CURRENT"
        ]
      },
      "required_facts": [
        "account.payment_status"
      ],
      "reason_code": "ACCOUNT_NOT_IN_GOOD_STANDING",
      "source_refs": [
        "RULES BR-02",
        "BRD Account_Standing"
      ],
      "regulatory_refs": [
        "IDD-ART-17"
      ]
    },
    {
      "id": "GK-03",
      "name": "Open formal complaint",
      "status": "ACTIVE",
      "suppress_when": {
        "==": [
          {
            "var": "conduct.open_complaint"
          },
          true
        ]
      },
      "required_facts": [
        "conduct.open_complaint"
      ],
      "reason_code": "GRIEVANCE_ACTIVE",
      "source_refs": [
        "BRD BR-04",
        "RULES BR-03",
        "BAC-06"
      ],
      "regulatory_refs": [
        "IDD-ART-17",
        "EIOPA-AI-OPINION-2025"
      ]
    },
    {
      "id": "GK-04",
      "name": "Disputed claim or litigation within lookback",
      "status": "ACTIVE",
      "suppress_when": {
        "or": [
          {
            "==": [
              {
                "var": "conduct.disputed_claim_in_lookback"
              },
              true
            ]
          },
          {
            "==": [
              {
                "var": "conduct.open_litigation"
              },
              true
            ]
          }
        ]
      },
      "required_facts": [
        "conduct.disputed_claim_in_lookback",
        "conduct.open_litigation"
      ],
      "reason_code": "DISPUTE_ACTIVE",
      "source_refs": [
        "RULES BR-03",
        "RULES BR-05 (property litigation)"
      ],
      "regulatory_refs": [
        "IDD-ART-17"
      ]
    },
    {
      "id": "GK-05",
      "name": "Sensitive open claims journey",
      "status": "ACTIVE",
      "suppress_when": {
        "==": [
          {
            "var": "conduct.open_claim_in_settlement"
          },
          true
        ]
      },
      "required_facts": [
        "conduct.open_claim_in_settlement"
      ],
      "reason_code": "CLAIM_IN_SETTLEMENT",
      "source_refs": [
        "BRD BR-05"
      ],
      "regulatory_refs": [
        "IDD-ART-17"
      ],
      "open_decisions": [
        "D-02"
      ]
    },
    {
      "id": "GK-06",
      "name": "Customer vulnerability hold",
      "status": "ACTIVE",
      "suppress_when": {
        "==": [
          {
            "var": "conduct.vulnerability_hold"
          },
          true
        ]
      },
      "required_facts": [
        "conduct.vulnerability_hold"
      ],
      "reason_code": "VULNERABILITY_HOLD",
      "source_refs": [
        "ARCHITECT (not in BA docs)"
      ],
      "regulatory_refs": [
        "IDD-ART-17",
        "EIOPA-AI-OPINION-2025"
      ],
      "open_decisions": [
        "D-10"
      ],
      "note": "Recommended addition. Flag only - never store the vulnerability reason in this system (possible GDPR Art. 9 data)."
    }
  ],
