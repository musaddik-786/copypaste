# Guidewire ClaimCenter connection (confidential — fill in real values, never commit them)
GW_CC_BASE_URL=https://cc-sandbox-gwcpdev.hexaware.zeta1-andromeda.guidewire.net/rest

# Option A (recommended — matches Postman's "Authorization" tab > Basic Auth):
# fill in username/password and leave GW_AUTHORIZATION blank.
GW_USERNAME=
GW_PASSWORD=

# Option B: set a pre-built header value instead (e.g. "Basic <base64>" or
# "Bearer <token>"). If set, this takes priority over GW_USERNAME/GW_PASSWORD.
GW_AUTHORIZATION=

GW_TIMEOUT_SECONDS=30
