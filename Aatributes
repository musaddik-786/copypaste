async def upload_layout_document_output(
    source_blob_url: str,
    result: dict,
) -> str:

    OUTPUT_CONTAINER = "layout-document-output"

    parsed_url = urlparse(source_blob_url)

    original_filename = os.path.basename(parsed_url.path)

    if not original_filename:
        raise ValueError(
            f"Unable to determine filename from blob URL: {source_blob_url}"
        )

    filename_without_extension = os.path.splitext(
        original_filename
    )[0]

    # ---------------------------------------------------------
    # Extract reference number and original document name
    # ---------------------------------------------------------
    if "_attachment_" in filename_without_extension:

        reference_number, document_name = (
            filename_without_extension.split(
                "_attachment_",
                1
            )
        )

    else:

        reference_number = filename_without_extension
        document_name = filename_without_extension

    # ---------------------------------------------------------
    # Output filename
    # ---------------------------------------------------------
    output_filename = (
        f"{reference_number}_layout_{document_name}.json"
    )

    # ---------------------------------------------------------
    # Create Azure Blob client
    # ---------------------------------------------------------
    async with BlobServiceClient.from_connection_string(
        AZURE_STORAGE_CONNECTION_STRING
    ) as blob_service:

        container_client = blob_service.get_container_client(
            OUTPUT_CONTAINER
        )

        try:
            await container_client.create_container()
        except ResourceExistsError:
            pass

        blob_client = container_client.get_blob_client(
            output_filename
        )

        # -----------------------------------------------------
        # Store COMPLETE classification response
        # -----------------------------------------------------
        response_json = json.dumps(
            result,
            indent=2,
            ensure_ascii=False
        )

        await blob_client.upload_blob(
            response_json,
            overwrite=True,
            content_settings=ContentSettings(
                content_type="application/json"
            ),
        )

        output_url = blob_client.url

        logger.info(
            "Layout document output uploaded: %s",
            output_url
        )

        return output_url









