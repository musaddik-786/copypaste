"""
coverage_handler.py
───────────────────
Business logic for:
  1. Guidewire policy search + policyholder existence check
  2. LLM-based coverage verification (reported loss vs policy terms)
  3. Loss reporting to Guidewire ClaimCenter
  4. Local DB persistence of verification results and policy details
"""

import json
import logging
import os
from datetime import datetime
from typing import Optional

from dotenv import load_dotenv
from openai import AzureOpenAI

from policy_coverage_mcp import guidewire_client
from policy_coverage_mcp.db import get_db_connection
from policy_coverage_mcp.models import (
    SaveCoverageVerificationRequest,
    SaveLocalPolicyRequest,
    VerifyCoverageRequest,
    GwReportLossRequest,
    UpdateClaimCoverageRequest,
)

load_dotenv()

log = logging.getLogger(__name__)

AZURE_OPENAI_ENDPOINT = os.environ.get("AZURE_OPENAI_ENDPOINT", "")
AZURE_OPENAI_API_KEY = os.environ.get("AZURE_OPENAI_API_KEY", "")
AZURE_OPENAI_API_VERSION = os.environ.get("AZURE_OPENAI_API_VERSION", "2025-01-01-preview")
AZURE_OPENAI_CHAT_DEPLOYMENT = os.environ.get("AZURE_OPENAI_CHAT_DEPLOYMENT", "gpt-4.1-jarvis-demo")


def _get_openai_client() -> AzureOpenAI:
    return AzureOpenAI(
        api_key=AZURE_OPENAI_API_KEY,
        api_version=AZURE_OPENAI_API_VERSION,
        azure_endpoint=AZURE_OPENAI_ENDPOINT,
    )


# ── Guidewire: Policy Search ──────────────────────────────────────────────────

def gw_search_policy(policy_number: str) -> dict:
    """
    Searches Guidewire PolicyCenter for the given policy number.

    Returns a normalised dict with:
      found            : bool
      policy           : flat policy dict (or None)
      error            : error message if not found / API error
      raw_gw_response  : the full Guidewire JSON (for downstream tools)
    """
    try:
        raw = guidewire_client.search_policy(policy_number)
        parsed = guidewire_client.parse_policy_from_search(raw)

        if not parsed:
            return {
                "found": False,
                "policy": None,
                "error": f"No policy found in Guidewire for policy number '{policy_number}'.",
                "raw_gw_response": raw,
            }

        return {
            "found": True,
            "policy": parsed,
            "error": None,
            "raw_gw_response": raw,
        }

    except Exception as exc:
        status_code = getattr(getattr(exc, "response", None), "status_code", None)
        if status_code == 404:
            return {
                "found": False,
                "policy": None,
                "error": f"Policy '{policy_number}' does not exist in Guidewire (HTTP 404). "
                         "Verify the policy number and retry.",
                "raw_gw_response": {},
            }
        log.exception("Guidewire policy search failed for %s", policy_number)
        return {
            "found": False,
            "policy": None,
            "error": f"Guidewire API error: {str(exc)}",
            "raw_gw_response": {},
        }


# ── Guidewire: Policy Coverages ───────────────────────────────────────────────

def gw_get_policy_coverages(policy_number: str) -> dict:
    """
    Fetches full coverage details for a policy from Guidewire.
    First searches by policy number, then fetches the policy detail record.
    """
    search_result = gw_search_policy(policy_number)
    if not search_result["found"]:
        return search_result

    gw_policy_id = search_result["policy"]["gw_policy_id"]
    try:
        detail = guidewire_client.get_policy_coverages(gw_policy_id)
        return {
            "found": True,
            "policy_id": gw_policy_id,
            "coverage_detail": detail,
            "error": None,
        }
    except Exception as exc:
        log.exception("Guidewire get_policy_coverages failed for %s", gw_policy_id)
        return {
            "found": False,
            "policy_id": gw_policy_id,
            "coverage_detail": None,
            "error": str(exc),
        }


# ── Coverage Verification (LLM) ───────────────────────────────────────────────

_COVERAGE_VERIFICATION_PROMPT = """
You are an expert insurance coverage analyst. Your job is to determine whether a
reported loss is covered under the given policy, based on the information available.

You will receive:
1. The reported loss type and description from the policyholder
2. The policy information retrieved from Guidewire (coverage types, status, dates)

Your task is to:
a) Confirm whether the policy is ACTIVE on the date of loss
b) Determine if the reported loss type falls within the policy's coverage
c) Identify any likely exclusions that may apply
d) Provide a clear coverage decision with reasoning

Return ONLY valid JSON in this exact format:
{
  "coverage_decision": "Covered" | "Not Covered" | "Conditionally Covered",
  "coverage_status":   "Confirmed" | "Excluded" | "Partial" | "Pending Review",
  "policy_active":     true | false,
  "coverage_type_matched": "<the specific coverage clause that applies, or null>",
  "deductible_applicable": <integer or null>,
  "limit_applicable": <integer or null>,
  "exclusion_reason": "<reason if not covered, or null>",
  "confidence": <0-100>,
  "reasoning": "<1-3 sentence explanation of your decision>",
  "missing_info": ["<any information needed to finalise determination>"]
}
"""


def verify_coverage_against_loss(req: VerifyCoverageRequest) -> dict:
    """
    Uses Azure OpenAI to compare the reported loss type and description
    against the policy coverage terms retrieved from Guidewire.

    If req.policy_data is not provided, automatically calls Guidewire first.
    """
    # Step 1: Get policy data if not supplied
    if req.policy_data:
        policy_info = req.policy_data
        gw_found = True
    else:
        search_result = gw_search_policy(req.policy_number)
        if not search_result["found"]:
            return {
                "coverage_decision": "Not Covered",
                "coverage_status": "Pending Review",
                "policy_active": False,
                "error": search_result["error"],
                "confidence": 0,
            }
        policy_info = search_result["policy"]
        gw_found = True

    # Step 2: Call Azure OpenAI to reason over coverage
    client = _get_openai_client()

    user_content = f"""
REPORTED LOSS:
  Claim ID    : {req.claim_id}
  Loss Type   : {req.reported_loss_type}
  Description : {req.loss_description or 'Not provided'}
  Loss Date   : {req.loss_date or 'Not provided'}

POLICY FROM GUIDEWIRE:
  Policy Number  : {req.policy_number}
  Status         : {policy_info.get('status', 'Unknown')}
  Effective Date : {policy_info.get('effective_date', 'Unknown')}
  Expiry Date    : {policy_info.get('expiration_date', 'Unknown')}
  Coverage Types : {policy_info.get('coverage_types', [])}
  Insured Name   : {policy_info.get('insured_name', 'Unknown')}
"""

    response = client.chat.completions.create(
        model=AZURE_OPENAI_CHAT_DEPLOYMENT,
        messages=[
            {"role": "system", "content": _COVERAGE_VERIFICATION_PROMPT},
            {"role": "user",   "content": user_content},
        ],
        temperature=0.0,
        response_format={"type": "json_object"},
    )

    content = response.choices[0].message.content
    try:
        result = json.loads(content)
        result["policy_number"] = req.policy_number
        result["claim_id"] = req.claim_id
        return result
    except json.JSONDecodeError:
        log.error("LLM returned non-JSON for coverage verification: %s", content)
        return {
            "coverage_decision": "Pending Review",
            "coverage_status": "Pending Review",
            "error": "Failed to parse LLM response",
            "raw": content,
        }


# ── Guidewire: Report Loss (FNOL) ─────────────────────────────────────────────

def report_loss_to_guidewire(req: GwReportLossRequest) -> dict:
    """
    Reports a new loss to Guidewire ClaimCenter by creating an FNOL record.
    Returns the Guidewire response including the GW claim ID.
    """
    try:
        gw_response = guidewire_client.report_loss_to_guidewire(
            policy_number=req.policy_number,
            claim_number=req.claim_number,
            loss_type=req.loss_type,
            loss_date=req.loss_date,
            loss_description=req.loss_description,
            insured_name=req.insured_name,
            loss_location=req.loss_location,
            estimated_amount=req.estimated_amount,
        )
        gw_claim_id = (
            gw_response.get("data", {}).get("id")
            or gw_response.get("data", {}).get("attributes", {}).get("claimNumber")
            or "Unknown"
        )
        return {
            "success": True,
            "gw_claim_id": gw_claim_id,
            "message": f"Loss reported to Guidewire. GW Claim ID: {gw_claim_id}",
            "raw_gw_response": gw_response,
        }
    except Exception as exc:
        log.exception("report_loss_to_guidewire failed for claim %s", req.claim_number)
        return {
            "success": False,
            "gw_claim_id": None,
            "message": f"Failed to report loss to Guidewire: {str(exc)}",
            "raw_gw_response": {},
        }


# ── Local DB: Save verification result ───────────────────────────────────────

def save_coverage_verification_result(req: SaveCoverageVerificationRequest) -> dict:
    """
    Saves the coverage verification outcome to intake_validation_result_output
    (re-used for coverage verification records) and upserts policy_details.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()

        validation_id = f"COV-{req.claim_id}-{int(datetime.utcnow().timestamp())}"

        # Save to intake_validation_result_output (coverage_status + result fields)
        cur.execute(
            """
            INSERT INTO intake_validation_result_output (
                validation_id, claim_id, completeness_score,
                coverage_status, fraud_risk, result, created_at
            ) VALUES (%s, %s, %s, %s, %s, %s, NOW())
            RETURNING *
            """,
            (
                validation_id,
                req.claim_id,
                100,  # completeness not relevant here
                req.coverage_status,
                "Low",
                req.coverage_decision,
            ),
        )
        verification_row = dict(cur.fetchone())

        # Upsert policy_details with Guidewire data
        cur.execute(
            "SELECT id FROM policy_details WHERE policy_id = %s LIMIT 1",
            (req.policy_number,),
        )
        existing = cur.fetchone()
        if existing:
            cur.execute(
                """
                UPDATE policy_details
                SET status = %s, coverage_type = %s, deductible = %s, "limit" = %s
                WHERE policy_id = %s
                RETURNING *
                """,
                (
                    "Active" if req.coverage_status == "Confirmed" else "Under Review",
                    req.coverage_type_matched,
                    req.deductible,
                    req.coverage_limit,
                    req.policy_number,
                ),
            )
        else:
            cur.execute(
                """
                INSERT INTO policy_details (policy_id, status, coverage_type, deductible, "limit")
                VALUES (%s, %s, %s, %s, %s)
                RETURNING *
                """,
                (
                    req.policy_number,
                    "Active" if req.coverage_status == "Confirmed" else "Under Review",
                    req.coverage_type_matched,
                    req.deductible,
                    req.coverage_limit,
                ),
            )
        policy_row = dict(cur.fetchone())

        conn.commit()
        return {
            "verification_record": verification_row,
            "policy_details":      policy_row,
            "validation_id":       validation_id,
        }
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


# ── Local DB: Read operations ─────────────────────────────────────────────────

def get_local_policy_details(policy_id: str) -> Optional[dict]:
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            "SELECT * FROM policy_details WHERE policy_id = %s LIMIT 1",
            (policy_id,),
        )
        row = cur.fetchone()
        return dict(row) if row else None
    finally:
        conn.close()


def get_claim_for_verification(claim_number: str) -> Optional[dict]:
    """
    Fetches the claims row (from the main `claims` table) for the given
    claim number, including coverage and loss-type fields needed for
    coverage verification.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            "SELECT * FROM claims WHERE claim_number = %s LIMIT 1",
            (claim_number,),
        )
        row = cur.fetchone()
        return dict(row) if row else None
    finally:
        conn.close()


def get_intake_validation_result(claim_id: str) -> Optional[dict]:
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT * FROM intake_validation_result_output
            WHERE claim_id = %s
            ORDER BY created_at DESC LIMIT 1
            """,
            (claim_id,),
        )
        row = cur.fetchone()
        return dict(row) if row else None
    finally:
        conn.close()


def update_claim_coverage_status(claim_number: str, req: UpdateClaimCoverageRequest) -> Optional[dict]:
    """
    Updates the coverage field and optionally status on the claims table
    after verification is complete.
    """
    fields = req.model_dump(exclude_none=True)
    if not fields:
        return get_claim_for_verification(claim_number)

    set_clauses = ", ".join(f"{k} = %s" for k in fields)
    values = list(fields.values()) + [claim_number]

    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            f"UPDATE claims SET {set_clauses} WHERE claim_number = %s RETURNING *",
            values,
        )
        row = cur.fetchone()
        conn.commit()
        return dict(row) if row else None
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()

