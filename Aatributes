async def upload_layout_document_output(
   source_blob_url: str,
   matched_document_type: str,
) -> str:
    """
    Creates an output blob in the 'layout-document-output' container.
    Input:
        source_blob_url:
            Original input text blob URL.
        matched_document_type:
            Final canonical document type returned by the fuzzy matcher.
    Example input blob:
        https://<account>.blob.core.windows.net/
        layout-detection-text-of-document/
        19FDC4A7758A1C40_attachment_Sample_Report_Inspected_Residential_NZ.txt
    Output blob:
        layout-document-output/
        19FDC4A7758A1C40_refd_Inspection_Report
    Returns:
        Full URL of the created output blob.
    """
    OUTPUT_CONTAINER = "layout-document-output"
    # ---------------------------------------------------------
    # 1. Extract original blob filename
    # ---------------------------------------------------------
    parsed_url = urlparse(source_blob_url)
    original_filename = os.path.basename(parsed_url.path)
    if not original_filename:
        raise ValueError(
            f"Unable to determine filename from blob URL: {source_blob_url}"
        )
    # Remove .txt
    filename_without_extension = os.path.splitext(
        original_filename
    )[0]
    # ---------------------------------------------------------
    # 2. Extract reference number
    #
    # Expected:
    # 19FDC4A7758A1C40_attachment_Sample_Report...
    #
    # We take everything before "_attachment_"
    # ---------------------------------------------------------
    if "_attachment_" in filename_without_extension:
        reference_number = filename_without_extension.split(
            "_attachment_",
            1
        )[0]
    else:
        # Fallback if "_attachment_" is not present
        reference_number = filename_without_extension
    # ---------------------------------------------------------
    # 3. Create output filename
    # ---------------------------------------------------------
    output_filename = (
        f"{reference_number}_refd_{matched_document_type}"
    )
    # ---------------------------------------------------------
    # 4. Get output container client
    # ---------------------------------------------------------
    container_client = service.get_container_client(
        OUTPUT_CONTAINER
    )
    # ---------------------------------------------------------
    # 5. Create container if it doesn't exist
    # ---------------------------------------------------------
    try:
        container_client.create_container()
    except Exception:
        # Container already exists
        pass
    # ---------------------------------------------------------
    # 6. Upload the classification result
    #
    # We store the matched document type as the blob content.
    # ---------------------------------------------------------
    blob_client = container_client.get_blob_client(
        output_filename
    )
    blob_client.upload_blob(
        matched_document_type,
        overwrite=True,
        content_settings=ContentSettings(
            content_type="text/plain"
        ),
    )
    output_url = blob_client.url
    logger.info(
        "Layout document output uploaded: %s",
        output_url
    )
    return output_url










