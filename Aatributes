#
# Each LOB gets its own Phoenix prompt containing only the layout types
# relevant to that LOB, so the LLM never has to consider unrelated
# categories from other lines of business.
# ---------------------------------------------------------------------------
PHOENIX_PROMPTS = {
    "Commercial Property": "UHJvbXB0VmVyc2lvbjo5MQ==",
    "General Liability": "UHJvbXB0VmVyc2lvbjo4Nw==",
    "Credit and Political Risk": "REPLACE_WITH_CREDIT_POLITICAL_RISK_PROMPT_VERSION",
    "Home Owners": "UHJvbXB0VmVyc2lvbjo5Mg==",
    "Life": "REPLACE_WITH_LIFE_PROMPT_VERSION",
}

SUPPORTED_LOBS = list(PHOENIX_PROMPTS.keys())

# The original code used max_tokens=4, which truncates longer canonical
# layout names (e.g. "Property_Detailed_Report", "MLPUKSUBMISSION").
# Raised to safely fit the longest allowed enum value while still keeping
# the model constrained to a single short output.
CLASSIFICATION_MAX_TOKENS = 32

# Kept for the legacy (non-LOB) calling path only - this was the single
# hardcoded Phoenix prompt version used before LOB-specific prompts existed.
LEGACY_PROMPT_VERSION = "UHJvbXB0VmVyc2lvbjo4NQ=="


class UnsupportedLOBError(ValueError):
    """Raised when a LOB value has no configured Phoenix prompt mapping."""
    pass


def _call_llm(prompt: str) -> str:
    response = client.chat.completions.create(
        model=AZURE_OPENAI_CHAT_DEPLOYMENT,
        messages=[{"role": "user", "content": prompt}],
        max_tokens=CLASSIFICATION_MAX_TOKENS,
        temperature=0.0
    )

    try:
        layout_type = response.choices[0].message.content.strip()
    except Exception as e:
        logger.warning("Failed to access message content via attribute, falling back: %s", e)
        layout_type = getattr(response.choices[0].message, "content", "").strip()

    return layout_type


