    text = document_content.get("text", "")
    logger.info("🔎 classify_document_legacy called: %d chars of text", len(text))

    # Same bug fix applied here.
    text_new = text[:2000]

    prompt = build_prompt(
        LEGACY_PROMPT_VERSION,
        text_new=text_new,
    )

    logger.info("🤖 Calling LLM for document classification (legacy path)")
    layout_type = _call_llm(prompt)

