def get_treaty_terms(treaty_ref: str):
    connection = get_db_connection()

    try:
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        query = """
            SELECT *
            FROM treaty_terms
            WHERE treaty_ref = %s
            ORDER BY layer_number
        """

        cursor.execute(query, (treaty_ref,))
        terms = cursor.fetchall()

        if not terms:
            return {
                "status": "not_found",
                "message": f"No terms found for treaty {treaty_ref}"
            }

        return {
            "status": "success",
            "treaty_ref": treaty_ref,
            "count": len(terms),
            "data": [dict(term) for term in terms]
        }

    finally:
        cursor.close()
        connection.close()










class TreatyTermsRequest(BaseModel):
    treaty_ref: str


@router.post("/get_treaty_terms", operation_id="get_treaty_terms")
def get_treaty_terms(req: TreatyTermsRequest):
    return handler.get_treaty_terms(req.treaty_ref)
