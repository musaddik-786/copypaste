def list_exclusions(treaty_ref: str):
    connection = get_db_connection()

    try:
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        query = """
            SELECT *
            FROM treaty_exclusions
            WHERE treaty_ref = %s
            ORDER BY exclusion_ref
        """

        cursor.execute(query, (treaty_ref,))
        exclusions = cursor.fetchall()

        if not exclusions:
            return {
                "status": "not_found",
                "message": f"No exclusions found for treaty {treaty_ref}"
            }

        return {
            "status": "success",
            "treaty_ref": treaty_ref,
            "count": len(exclusions),
            "data": [dict(exclusion) for exclusion in exclusions]
        }

    finally:
        cursor.close()
        connection.close()





def get_clause(clause_ref: str, treaty_ref: str):
    connection = get_db_connection()

    try:
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        query = """
            SELECT *
            FROM treaty_clauses
            WHERE clause_ref = %s
              AND treaty_ref = %s
        """

        cursor.execute(query, (clause_ref, treaty_ref))
        clause = cursor.fetchone()

        if not clause:
            return {
                "status": "not_found",
                "message": (
                    f"Clause {clause_ref} was not found "
                    f"for treaty {treaty_ref}"
                )
            }

        return {
            "status": "success",
            "data": dict(clause)
        }

    finally:
        cursor.close()
        connection.close()









class ListExclusionsRequest(BaseModel):
    treaty_ref: str


@router.post("/list_exclusions", operation_id="list_exclusions")
def list_exclusions(req: ListExclusionsRequest):
    return handler.list_exclusions(req.treaty_ref)
class GetClauseRequest(BaseModel):
    clause_ref: str
    treaty_ref: str


@router.post("/get_clause", operation_id="get_clause")
def get_clause(req: GetClauseRequest):
    return handler.get_clause(
        req.clause_ref,
        req.treaty_ref
    )
