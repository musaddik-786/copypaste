import uvicorn


app = FastAPI(docs_url="/docs", title="Jarvis Claims MCP Server")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


# ── Sub-app: voice_text_intake_agent ─────────────────────────────────────────

def _make_cors_app(title: str, description: str = "") -> FastAPI:
    sub = FastAPI(title=title, description=description)
    sub.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_methods=["*"],
        allow_headers=["*"],
    )
    return sub


voice_intake_app = _make_cors_app(
    title="voice_text_intake_agent_mcps",
    description="MCP tools for FNOL Voice/Text Intake: transcription, "
                "field extraction, submission management, and audit logging.",
)
voice_intake_app.include_router(fnol_router)

FastApiMCP(
    voice_intake_app,
    include_operations=[
        "create_fnol_submission",
        "get_fnol_submission",
        "get_fnol_by_policy",
        "update_fnol_submission",
        "submit_fnol",
        "get_mandatory_fields",
        "save_voice_text_extraction",
        "get_voice_text_extractions",
        "save_ai_inferences",
        "log_question_answer",
        "get_question_log",
        "save_field_attribution",
        "transcribe_voice_input",
        "extract_fnol_fields_from_text",
        "save_voice_recording",
    ],
).mount_http()

app.mount("/api/v1/voice_text_intake", voice_intake_app)


# ── Sub-app: policy_coverage_verification_agent ───────────────────────────────

policy_coverage_app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

FastApiMCP(
    policy_coverage_app,
    include_operations=[
        "gw_search_policy",
        "gw_get_policy_coverages",
        "verify_coverage_against_loss",
        "report_loss_to_guidewire",
        "save_coverage_verification_result",
        "get_local_policy_details",
        "get_claim_for_verification",
        "get_intake_validation_result",
        "update_claim_coverage_status",
    ],
).mount_http()

app.mount("/api/v2/policy_coverage", policy_coverage_app)


# ── Health ────────────────────────────────────────────────────────────────────

@app.get("/health")
def health():
    return {
        "status": "healthy",
        "service": "jarvis_claims_mcp",
        "sub_apps": ["voice_text_intake", "policy_coverage"],
