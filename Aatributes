import os
from dotenv import load_dotenv

load_dotenv(os.path.join(os.path.dirname(__file__), ".env"))

import sys
sys.path.insert(0, os.path.dirname(__file__))

from graph import graph
from langgraph.types import Command

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from pydantic import BaseModel
import uvicorn
import json

AGENT_PORT = int(os.getenv("AGENT_PORT", "8002"))

# ── SSE Streaming Helpers ─────────────────────────────────────────────────────

async def _stream_graph(input_data, thread_id: str):
    """Shared generator for both /chat and /continue_chat."""
    config = {"configurable": {"thread_id": thread_id}, "recursion_limit": 100}
    try:
        async for event in graph.astream(input_data, config):
            for value in event.values():
                if "messages" in value:
                    msg = value["messages"][-1]
                    if hasattr(msg, "model_dump"):
                        data = {"message": msg.model_dump()}
                    elif hasattr(msg, "dict"):
                        data = {"message": msg.dict()}
                    else:
                        data = {"message": str(msg)}
                    yield f"data: {json.dumps(data)}\n\n"
                else:
                    # LangGraph interrupt — human assistance required
                    try:
                        interrupt_payload = {
                            "query":   value[0].value["query"],
                            "id":      value[0].id,
                            "session": thread_id,
                        }
                        yield f"data: {json.dumps({'interrupt': interrupt_payload})}\n\n"
                    except (IndexError, KeyError, TypeError):
                        yield f"data: {json.dumps({'interrupt': {'query': str(value), 'session': thread_id}})}\n\n"
    except Exception as exc:
        yield f"data: {json.dumps({'error': str(exc)})}\n\n"


async def stream(message: str, thread_id: str):
    input_data = {"messages": [{"role": "user", "content": message}]}
    async for chunk in _stream_graph(input_data, thread_id):
        yield chunk


async def continue_stream(message: str, thread_id: str):
    input_data = Command(resume={"messages": [{"role": "user", "content": message}]})
    async for chunk in _stream_graph(input_data, thread_id):
        yield chunk

# ── FastAPI App ───────────────────────────────────────────────────────────────

app = FastAPI(
    title="Jarvis Triage & Routing Agent",
    description="Autonomous AI claims triage agent powered by LangGraph. Scores complexity, classifies STP category, and routes claims to auto-adjudication, adjuster queue, or SIU.",
    version="1.0.0",
    docs_url="/docs",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ── Request Schema ────────────────────────────────────────────────────────────

class ChatInput(BaseModel):
    query: str
    thread_id: str

# ── Routes ────────────────────────────────────────────────────────────────────

@app.post(
    "/chat",
    summary="Start or continue a claim session",
    description="Send a message to Jarvis. Returns a server-sent event stream. "
                "Each event is either `{message: {...}}` (agent output) or "
                "`{interrupt: {query, id, session}}` (human assistance required).",
)
async def chat(input: ChatInput):
    return StreamingResponse(
        stream(input.query, input.thread_id),
        media_type="text/event-stream",
    )


@app.post(
    "/continue_chat",
    summary="Resume after a human-assistance interrupt",
    description="Called after the agent emits an `interrupt` event. "
                "Pass the same `thread_id` and the human's response as `query`.",
)
async def continue_chat(input: ChatInput):
    return StreamingResponse(
        continue_stream(input.query, input.thread_id),
        media_type="text/event-stream",
    )


@app.get("/health", summary="Health check")
async def health():
    return {
        "status": "ok",
        "agent": "Jarvis Triage & Routing Agent",
        "port": AGENT_PORT,
    }

# ── Entry Point ───────────────────────────────────────────────────────────────

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=AGENT_PORT)

# Agentic AI — Tool Design for Claims Platform

This document maps out every MCP tool server and the specific tools each agent needs, grounded in the existing database schema and API surface of this platform.

---

## Architecture Overview

Following the Jarvis pattern (already used in the parent workspace), each tool server is an independent **FastAPI-MCP microservice**. Agents connect to these via `MultiServerMCPClient` and call tools as part of their LangGraph state machine graphs.

```
LangGraph Agent (per workflow)
        ↓ calls tools via MCP
┌──────────────────────────────────────────────────┐
│              MCP Tool Servers                    │
│                                                  │
│  claims_core_mcp      fnol_mcp                  │
│  fraud_mcp            stp_mcp                   │
│  vendor_mcp           decision_mcp              │
│  expert_dispatch_mcp  communication_mcp         │
│  cost_estimation_mcp  document_analysis_mcp     │
└──────────────────────────────────────────────────┘
        ↓ reads/writes
  Azure PostgreSQL (via Drizzle ORM)
  Google Cloud Storage (documents/images)
```

---

## MCP Tool Servers

---

### 1. `claims_core_mcp`

Wraps all core claim lifecycle operations. Used by almost every agent.

| Tool | Description | DB Tables Touched |
|------|-------------|-------------------|
| `get_claim_by_id` | Fetch full claim detail by ID | `claims` |
| `get_claim_by_number` | Fetch claim by claim number | `claims`, `claims_master` |
| `search_claims` | Filter claims by status, loss type, severity, date range | `claims` |
| `create_claim` | Create a new claim record | `claims`, `claims_master`, `claim_journey_master`, `fnol_data`, `policy_details` |
| `update_claim_status` | Transition claim to a new status stage | `claims`, `claim_journey_master` |
| `get_claim_journey` | Get full stage-by-stage journey for a claim | `claim_journey_master`, `stage_time_sla_tracking` |
| `get_interaction_timeline` | Get chronological audit trail for a claim | `interaction_timeline` |
| `get_policy_details` | Fetch policy coverage and limits for a claim | `policy_details` |
| `get_similar_claims` | Find historically similar claims by loss type, severity, location | `claims`, `claims_master` |
| `run_intake_validation` | Trigger intake validation checks on a claim | `intake_validation_result_output`, `segmentation_result_output` |
| `get_intake_validation_result` | Retrieve intake validation result for a claim | `intake_validation_result_output` |
| `get_segmentation_result` | Retrieve segmentation/STP routing for a claim | `segmentation_result_output` |
| `get_risk_evaluation_snapshot` | Get fraud score, coverage status, complexity snapshot | `risk_evaluation_snapshots` |
| `add_interaction` | Log an interaction event to the claim timeline | `interaction_timeline` |
| `get_adjuster_findings` | Retrieve adjuster summary judgment for a claim | `adjuster_findings` |
| `write_adjuster_findings` | Write adjuster narrative, fraud risk, reserve, recommendation | `adjuster_findings` |
| `get_evidence_items` | List all evidence items for a claim | `evidence_items` |
| `add_evidence_item` | Register a new evidence item (photo, doc, report) | `evidence_items` |

---

### 2. `fnol_mcp`

Handles intelligent FNOL intake — extracting structured data from voice, text, and images. Used by the FNOL Intake Agent.

| Tool | Description | DB Tables Touched |
|------|-------------|-------------------|
| `create_fnol_submission` | Create a new FNOL record | `fnol_submissions` |
| `get_fnol_by_id` | Fetch an FNOL submission | `fnol_submissions` |
| `update_fnol_field` | Update a specific field in the FNOL | `fnol_submissions` |
| `get_mandatory_fields` | List all required FNOL fields and whether they can be inferred | `fnol_mandatory_fields` |
| `write_ai_inference` | Store an AI-inferred field value with confidence score | `fnol_ai_inferences` |
| `get_ai_inferences` | Get all AI-inferred field values for an FNOL | `fnol_ai_inferences` |
| `confirm_inference` | Mark a field inference as customer-confirmed or edited | `fnol_ai_inferences` |
