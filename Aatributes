SELECT
    id,
    fnol_number,
    policy_number,
    loss_type,
    cause_of_loss,
    date_of_loss,
    time_of_loss,
    accident_location,
    severity,
    passenger_count,
    tow_required,
    police_fir_number,
    sudden_vs_gradual,
    emotional_context,
    urgency_indicator,
    overall_confidence,
    status,
    submitted_at
FROM motor_fnol_submissions
WHERE policy_number = 'POL-1002'
ORDER BY created_at DESC;


SELECT
    id,
    fnol_id,
    field_name,
    inferred_value,
    confidence,
    source,
    source_details
FROM motor_fnol_ai_inferences
WHERE fnol_id = <FNOL_ID>
ORDER BY id;


SELECT
    question_order,
    field_name,
    question_text,
    answer_text,
    was_skipped
FROM motor_fnol_mandatory_question_log
WHERE fnol_id = <FNOL_ID>
ORDER BY question_order;
