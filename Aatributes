def list_treaties(
    status: str | None = None,
    class_of_business: str | None = None,
    as_at: str | None = None
):
    connection = get_db_connection()

    try:
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        query = """
            SELECT *
            FROM treaties
            WHERE 1=1
        """

        params = []

        if status:
            query += " AND status = %s"
            params.append(status)

        if class_of_business:
            query += " AND class_of_business = %s"
            params.append(class_of_business)

        if as_at:
            query += " AND inception_date <= %s"
            params.append(as_at)

        query += " ORDER BY treaty_ref"

        cursor.execute(query, params)

        treaties = cursor.fetchall()

        return {
            "status": "success",
            "count": len(treaties),
            "data": [dict(treaty) for treaty in treaties]
        }

    finally:
        cursor.close()
        connection.close()















class TreatyListRequest(BaseModel):
    status: str | None = None
    class_of_business: str | None = None
    as_at: str | None = None


@router.post("/list_treaties", operation_id="list_treaties")
def list_treaties(req: TreatyListRequest):
    return handler.list_treaties(
        req.status,
        req.class_of_business,
        req.as_at
    )
