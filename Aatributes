async def read_text_blob(blob_url: str) -> str:

    container, blob_path = _parse_blob_url(blob_url)

    parsed = urlparse(blob_url)

    logger.info(
        "========== READ TEXT BLOB =========="
    )

    logger.info(
        "URL account: %s",
        parsed.netloc
    )

    logger.info(
        "Container: %s",
        container
    )

    logger.info(
        "Blob path: %s",
        blob_path
    )

    async with BlobServiceClient.from_connection_string(
        AZURE_STORAGE_CONNECTION_STRING
    ) as service:

        account_url = service.url

        logger.info(
            "Connection string account URL: %s",
            account_url
        )

        container_client = service.get_container_client(container)
        blob_client = container_client.get_blob_client(blob_path)

        try:

            properties = await blob_client.get_blob_properties()

            logger.info(
                "Blob FOUND! Size=%s bytes",
                properties.size
            )

        except ResourceNotFoundError:

            logger.error(
                "BLOB NOT FOUND"
            )

            logger.error(
                "Expected account: %s",
                parsed.netloc
            )

            logger.error(
                "Actual connection account: %s",
                account_url
            )

            logger.error(
                "Container: %s",
                container
            )

            logger.error(
                "Blob: %s",
                blob_path
            )

            raise FileNotFoundError(
                f"Text blob not found: "
                f"container={container} "
                f"blob={blob_path}"
            )

        stream = await blob_client.download_blob()
        data = await stream.readall()

    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        text = data.decode("latin-1")

    logger.info(
        "Text blob successfully read: %d chars",
        len(text)
    )

    logger.info(
        "========== READ TEXT BLOB END =========="
    )

    return text




