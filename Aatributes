from pydantic import BaseModel, Field
from typing import Optional, List, Any


# ── Guidewire requests ────────────────────────────────────────────────────────

class GwSearchPolicyRequest(BaseModel):
    policy_number: str = Field(..., description="Policy number to look up in Guidewire, e.g. '9802322834'")


class GwReportLossRequest(BaseModel):
    policy_number: str = Field(..., description="Policy number the loss is reported against")
    claim_number: str = Field(..., description="Local claim number, e.g. CLM-2026-1234")
    loss_type: str = Field(..., description="Type of loss, e.g. 'Water Damage', 'Fire'")
    loss_date: str = Field(..., description="Date of loss in YYYY-MM-DD format")
    loss_description: str = Field(..., description="Free-text description of what happened")
    loss_location: Optional[str] = Field(None, description="Address or area where loss occurred")
    insured_name: str = Field(..., description="Name of the insured policyholder")
    estimated_amount: Optional[float] = Field(None, description="Policyholder's estimated loss amount")


# ── Coverage verification ─────────────────────────────────────────────────────

class VerifyCoverageRequest(BaseModel):
    claim_id: str = Field(..., description="Local claim number or FNOL id")
    policy_number: str = Field(..., description="Policy number to verify against")
    reported_loss_type: str = Field(..., description="Loss type reported by policyholder, e.g. 'Water Damage'")
    loss_description: Optional[str] = Field(None, description="Full text description of the loss")
    loss_date: Optional[str] = Field(None, description="Date of loss YYYY-MM-DD")
    policy_data: Optional[dict] = Field(
        None,
        description="Raw Guidewire policy response — pass the output of gw_search_policy here. "
                    "If not provided the tool will call Guidewire automatically.",
    )


class SaveCoverageVerificationRequest(BaseModel):
    claim_id: str = Field(..., description="Local claim number")
    policy_number: str = Field(..., description="Policy number that was verified")
    coverage_status: str = Field(..., description="'Confirmed', 'Excluded', 'Partial', 'Pending Review'")
    coverage_decision: str = Field(..., description="'Covered', 'Not Covered', 'Conditionally Covered'")
    coverage_type_matched: Optional[str] = Field(None, description="The specific coverage clause that applies")
    deductible: Optional[int] = Field(None, description="Applicable deductible from policy")
    coverage_limit: Optional[int] = Field(None, description="Applicable coverage limit from policy")
    exclusion_reason: Optional[str] = Field(None, description="Reason for exclusion if not covered")
    verification_notes: Optional[str] = Field(None, description="Additional notes from verification")
    gw_policy_id: Optional[str] = Field(None, description="Guidewire internal policy ID")
    verified_by: Optional[str] = Field("Policy Coverage Verification Agent", description="Who performed the verification")


# ── Local DB ──────────────────────────────────────────────────────────────────

class SaveLocalPolicyRequest(BaseModel):
    policy_id: str
    status: Optional[str] = "Active"
    coverage_type: Optional[str] = None
    deductible: Optional[int] = None
    limit: Optional[int] = None


class UpdateClaimCoverageRequest(BaseModel):
    coverage: Optional[bool] = None
    status: Optional[str] = None
    ai_confidence: Optional[int] = None

