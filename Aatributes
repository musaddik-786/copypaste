"""
guidewire_client.py
───────────────────
All HTTP calls to the Guidewire PolicyCenter and ClaimCenter REST APIs.

PolicyCenter base : https://pc-sandbox-gwcpdev.hexaware.zeta1-andromeda.guidewire.net/rest
ClaimCenter base  : https://cc-sandbox-gwcpdev.hexaware.zeta1-andromeda.guidewire.net/rest
                    (adjust CC_BASE_URL in .env if the Claims Center host differs)
"""

import logging
import os
from typing import Optional

import requests
from dotenv import load_dotenv

load_dotenv()

log = logging.getLogger(__name__)

# ── Config ────────────────────────────────────────────────────────────────────

PC_BASE_URL = os.environ.get(
    "GW_PC_BASE_URL",
    "https://pc-sandbox-gwcpdev.hexaware.zeta1-andromeda.guidewire.net/rest",
)
CC_BASE_URL = os.environ.get(
    "GW_CC_BASE_URL",
    "https://cc-sandbox-gwcpdev.hexaware.zeta1-andromeda.guidewire.net/rest",
)
GW_AUTH = os.environ.get("GW_AUTHORIZATION", "Basic c3U6Z3c=")

HEADERS = {
    "accept": "application/json",
    "Content-Type": "application/json",
    "authorization": GW_AUTH,
}

REQUEST_TIMEOUT = int(os.environ.get("GW_TIMEOUT_SECONDS", "30"))


# ── Low-level helpers ─────────────────────────────────────────────────────────

def _pc_post(uri: str, body: dict) -> dict:
    url = PC_BASE_URL + uri
    log.info("GW PC POST %s", url)
    resp = requests.post(url, json=body, headers=HEADERS, timeout=REQUEST_TIMEOUT)
    _raise_for_status(resp, "PC POST", uri)
    return resp.json()


def _pc_get(uri: str, params: Optional[dict] = None) -> dict:
    url = PC_BASE_URL + uri
    log.info("GW PC GET %s", url)
    resp = requests.get(url, headers=HEADERS, params=params, timeout=REQUEST_TIMEOUT)
    _raise_for_status(resp, "PC GET", uri)
    return resp.json()


def _cc_post(uri: str, body: dict) -> dict:
    url = CC_BASE_URL + uri
    log.info("GW CC POST %s", url)
    resp = requests.post(url, json=body, headers=HEADERS, timeout=REQUEST_TIMEOUT)
    _raise_for_status(resp, "CC POST", uri)
    return resp.json()


def _raise_for_status(resp: requests.Response, method: str, uri: str):
    if not resp.ok:
        log.error(
            "Guidewire %s %s → HTTP %s: %s",
            method, uri, resp.status_code, resp.text[:500],
        )
        resp.raise_for_status()


# ── PolicyCenter — Policy Search ──────────────────────────────────────────────

def search_policy(policy_number: str) -> dict:
    """
    Search for a policy in Guidewire PolicyCenter by policy number.

    Uses: POST /policy/v1/search/policies
    Body: {"data": {"attributes": {"policyNumber": "<policy_number>"}}}

    Returns:
        The full Guidewire JSON response on success.
        Raises requests.HTTPError (404 etc.) if not found.

    Caller should check:
        result["data"]              — list of matched policies
        result["data"][0]           — first match
        result["data"][0]["attributes"]["policyNumber"]
        result["data"][0]["attributes"]["account"]["accountNumber"]
        result["data"][0]["attributes"]["periods"][0]["status"]
        result["data"][0]["attributes"]["periods"][0]["lines"]
    """
    body = {
        "data": {
            "attributes": {
                "policyNumber": policy_number
            }
        }
    }
    return _pc_post("/policy/v1/search/policies", body)


def get_policy_coverages(policy_id: str) -> dict:
    """
    Retrieve detailed coverage information for a policy period from Guidewire.

    Uses: GET /policy/v1/policies/{policyId}
    """
    return _pc_get(f"/policy/v1/policies/{policy_id}")


# ── ClaimCenter — Loss / FNOL Reporting ──────────────────────────────────────

def report_loss_to_guidewire(
    policy_number: str,
    claim_number: str,
    loss_type: str,
    loss_date: str,
    loss_description: str,
    insured_name: str,
    loss_location: Optional[str] = None,
    estimated_amount: Optional[float] = None,
) -> dict:
    """
    Reports a new loss (FNOL) to Guidewire ClaimCenter.

    Uses: POST /claim/v1/fnols

    Maps local loss type to Guidewire loss cause codes:
        Water Damage  → WaterDamage
        Fire          → Fire
        Wind/Hail     → WindHail
        Theft         → Theft
        Structural    → Other
        Tree Damage   → WindHail
        Motor/Auto    → Collision
        Other         → Other

    Returns the Guidewire claim ID and confirmation number on success.
    """
    loss_cause_map = {
        "water damage":  "WaterDamage",
        "fire":          "Fire",
        "fire damage":   "Fire",
        "wind/hail":     "WindHail",
        "hail":          "WindHail",
        "wind":          "WindHail",
        "tree damage":   "WindHail",
        "theft":         "Theft",
        "structural":    "Other",
        "motor":         "Collision",
        "auto":          "Collision",
        "collision":     "Collision",
    }
    loss_cause = loss_cause_map.get(loss_type.lower().strip(), "Other")

    body = {
        "data": {
            "attributes": {
                "policyNumber": policy_number,
                "lossDate": loss_date,
                "lossCause": loss_cause,
                "description": loss_description,
                "claimNumber": claim_number,
                "insured": {
                    "displayName": insured_name
                },
            }
        }
    }

    if loss_location:
        body["data"]["attributes"]["lossLocation"] = {"displayName": loss_location}

    if estimated_amount is not None:
        body["data"]["attributes"]["estimatedTotalClaim"] = {
            "amount": estimated_amount,
            "currency": "USD",
        }

    return _cc_post("/claim/v1/fnols", body)


# ── Response parsers ──────────────────────────────────────────────────────────

def parse_policy_from_search(gw_response: dict) -> Optional[dict]:
    """
    Extracts a flat, normalised policy dict from a Guidewire search response.

    Returns None if no policies were found.
    """
    data_list = gw_response.get("data", [])
    if not data_list:
        return None

    policy = data_list[0]
    attrs = policy.get("attributes", {})
    periods = attrs.get("periods", [{}])
    period = periods[0] if periods else {}
    period_attrs = period.get("attributes", {}) if isinstance(period, dict) else {}

    # Account
    account = attrs.get("account", {})
    account_attrs = account.get("attributes", {}) if isinstance(account, dict) else {}

    # Lines of business (coverages)
    lines = period_attrs.get("lines", [])
    coverage_types = []
    for line in lines:
        line_attrs = line.get("attributes", {}) if isinstance(line, dict) else {}
        if line_attrs.get("lineOfBusiness"):
            coverage_types.append(line_attrs["lineOfBusiness"])

    return {
        "gw_policy_id":    policy.get("id", ""),
        "policy_number":   attrs.get("policyNumber", ""),
        "status":          period_attrs.get("status", "Unknown"),
        "effective_date":  period_attrs.get("periodStart", ""),
        "expiration_date": period_attrs.get("periodEnd", ""),
        "coverage_types":  coverage_types,
        "insured_name":    account_attrs.get("accountHolderName", ""),
        "account_number":  account_attrs.get("accountNumber", ""),
        "raw":             gw_response,
    }

