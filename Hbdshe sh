from mcp.server.fastmcp import FastMCP

mcp = FastMCP("Claims Server")

CLAIMS = {
    "CLM001": {
        "claim_id": "CLM001",
        "policy_id": "POL1001",
        "status": "OPEN",
        "estimated_amount": 18500
    },
    "CLM002": {
        "claim_id": "CLM002",
        "policy_id": "POL1002",
        "status": "CLOSED",
        "estimated_amount": 75000
    }
}


@mcp.tool()
def get_claim(claim_id: str) -> dict:
    """Retrieve claim details using a claim ID."""

    claim = CLAIMS.get(claim_id)

    if claim is None:
        return {
            "error": f"Claim {claim_id} not found"
        }

    return claim


if __name__ == "__main__":
    mcp.run(transport="stdio")



