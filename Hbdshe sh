import { useCallback, useEffect, useRef, useState } from "react";
import { AlertTriangle, Check, Download, Loader2, ShieldCheck, X } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { decideFix, resolveFix, getFixRun, runFixStage } from "@/lib/api";
import type { FixRequirement, FixRun } from "@/lib/types";
import { cn } from "@/lib/utils";
import { SimilarTicketsPanel } from "@/components/similar-tickets-panel";

type Stage = "l1" | "l2" | "l3";
const STEPS: { id: Stage; label: string; hint: string }[] = [
  { id: "l1", label: "L1 Guided steps", hint: "What we know and what is still missing" },
  { id: "l2", label: "L2 Diagnosis", hint: "Read-only checks and root cause" },
  { id: "l3", label: "L3 Data fix", hint: "Gosu script and change requirement" },
];

interface Props {
  ticket: { id: string; title: string; description: string };
}

export function FixWorkbench({ ticket }: Props) {
  const [run, setRun] = useState<FixRun | null>(null);
  const [active, setActive] = useState<Stage>("l1");
  const [busy, setBusy] = useState<Stage | null>(null);
  const [error, setError] = useState("");
  const [sources, setSources] = useState<Record<string, string>>({});
  const [user, setUser] = useState("Sai K");

  const reload = useCallback(async () => setRun(await getFixRun(ticket.id)), [ticket.id]);
  useEffect(() => {
    setError("");
    reload().catch((e) => setError(e.message));
  }, [reload]);

  const sectionRef = useRef<HTMLElement>(null);
  const done = (s: Stage) => Boolean(run?.outputs[s]);
  const execute = async (stage: Stage) => {
    setBusy(stage);
    setError("");
    try {
      const r = await runFixStage(ticket.id, stage, { title: ticket.title, description: ticket.description }, user);
      setSources((p) => ({ ...p, [stage]: r.source }));
      await reload();
      setActive(stage);
      // the page scrolls inside the ticket overlay, so move every scrollable ancestor to the top
      for (let el: HTMLElement | null = sectionRef.current; el; el = el.parentElement) el.scrollTo?.({ top: 0, behavior: "smooth" });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Something went wrong");
    } finally {
      setBusy(null);
    }
  };

  const o = run?.outputs ?? {};
  const decided = run?.status === "approved" || run?.status === "rejected";

  return (
    <>
    <section ref={sectionRef} className="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
      <div className="flex flex-wrap items-center justify-between gap-3 border-b border-border bg-[#0B2A4A]/5 px-5 py-3 text-[#0B2A4A]">
        <div className="flex items-center gap-2 font-semibold">
          <ShieldCheck className="h-4 w-4 text-primary" /> Resolution workbench
          {o.card && <Badge variant="outline">{o.card.article_id}</Badge>}
        </div>
        <Badge variant="outline" className={cn("font-medium",
          run?.status === "closed" ? "border-slate-300 bg-slate-100 text-slate-800"
          : run?.status === "approved" ? "border-green-300 bg-green-50 text-green-800"
          : run?.status === "rejected" ? "border-red-300 bg-red-50 text-red-800"
          : o.l3 ? "border-amber-300 bg-amber-50 text-amber-800" : "border-primary/30 bg-primary/10 text-primary")}>
          {run?.status === "closed" ? "Closed"
            : run?.status === "approved" ? "Approved, ready for change control"
            : run?.status === "rejected" ? "Rejected"
            : o.l3 ? "Awaiting L3 approval" : done("l2") ? "Diagnosed" : done("l1") ? "L1 guided" : "Not started"}
        </Badge>
      </div>

      <div className="grid gap-2 border-b border-border bg-muted/40 px-5 py-3 sm:grid-cols-3">
        {STEPS.map((s, i) => (
          <button key={s.id} type="button" onClick={() => setActive(s.id)}
            className={cn("flex items-center gap-3 rounded-md border bg-card px-3 py-2.5 text-left text-sm shadow-sm transition-colors",
              active === s.id ? "border-primary bg-primary/10 font-medium text-primary"
              : done(s.id) ? "border-green-300 bg-green-50 text-green-900" : "border-border hover:bg-muted")}>
            {done(s.id) ? <Check className="h-4 w-4 text-green-600" /> : <span className="text-xs text-muted-foreground">{i + 1}</span>}
            <span>{s.label}<span className="block text-xs font-normal text-muted-foreground">{s.hint}</span></span>
          </button>
        ))}
      </div>

      <div className="space-y-4 px-5 py-4 text-sm">
        {error && <p className="flex items-center gap-2 text-destructive"><AlertTriangle className="h-4 w-4" />{error}</p>}
        {sources[active] === "saved-sample" && (
          <p className="rounded-md bg-amber-50 px-3 py-2 text-amber-900">AI service unreachable. Showing saved sample output, not a live result.</p>
        )}

        {active === "l1" && (
          <>
            {!o.l1 ? <Run label="Run L1 guide" busy={busy === "l1"} onClick={() => execute("l1")} /> : (
              <>
                <p className="text-muted-foreground">Matched {o.card?.article_id}: {o.card?.title}</p>
                <ul className="space-y-2">
                  {o.l1.items.map((it) => (
                    <li key={it.item} className={cn("flex gap-2 rounded-md px-3 py-2", it.answered ? "bg-green-50" : "bg-amber-50")}>
                      {it.answered ? <Check className="mt-0.5 h-4 w-4 shrink-0 text-green-600" /> : <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-amber-600" />}
                      <span>{it.item}{it.found && <span className="block text-xs text-muted-foreground">Found: {it.found}</span>}</span>
                    </li>
                  ))}
                </ul>
                {o.l1.requester_reply && (
                  <div><div className="mb-1 font-medium">Message to the requester</div>
                    <p className="rounded-md border border-border bg-muted/40 p-3">{o.l1.requester_reply}</p></div>
                )}
                <p className="text-muted-foreground"><b>Escalate to L2 when:</b> {o.l1.escalation}</p>
                <Button variant="outline" onClick={() => execute("l2")} disabled={busy !== null}>
                  {busy === "l2" && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Continue to L2 diagnosis
                </Button>
              </>
            )}
          </>
        )}

        {active === "l2" && (
          <>
            {!o.l2 ? <Run label="Run L2 diagnosis" busy={busy === "l2"} onClick={() => execute("l2")} disabled={!o.l1} /> : (
              <>
                <p className="text-xs text-muted-foreground">{o.l2.evidence_label}</p>
                <ul className="space-y-2">
                  {o.l2.checks.map((c) => (
                    <li key={c.id} className="rounded-md border border-border px-3 py-2">
                      <div className="flex items-center gap-2 font-medium">
                        {c.ok ? <Check className="h-4 w-4 text-green-600" /> : <X className="h-4 w-4 text-destructive" />}{c.what}
                      </div>
                      <div className="mt-1">Found: {c.found}</div>
                      <code className="mt-1 block text-xs text-muted-foreground">{c.query}</code>
                    </li>
                  ))}
                </ul>
                <div className="rounded-md bg-primary/10 p-3"><b>Conclusion ({o.l2.confidence} confidence):</b> {o.l2.conclusion}</div>
                {o.l2.needs_data_fix && (
                  <Button variant="outline" onClick={() => execute("l3")} disabled={busy !== null}>
                    {busy === "l3" && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}{busy === "l3" ? "Writing and checking the Gosu fix (about 30 to 60s)…" : "Escalate to L3 data fix"}
                  </Button>
                )}
              </>
            )}
          </>
        )}

        {active === "l3" && (
          <>
            {!o.l3 ? <Run label="Generate Gosu fix" busy={busy === "l3"} onClick={() => execute("l3")} disabled={!o.l2?.needs_data_fix} /> : (
              <>
                <div className="grid gap-4 lg:grid-cols-2">
                  <div className="space-y-3">
                    <div className="font-medium">Generated Gosu script <span className="font-normal text-muted-foreground">({o.l3.repairs} auto-repairs)</span></div>
                    <pre className="overflow-x-auto rounded-md bg-muted p-3 font-mono text-xs leading-relaxed">{o.l3.gosu}</pre>
                    <p>{o.l3.explanation}</p>
                    <p className="rounded-md bg-amber-50 p-3 text-amber-900">{o.l3.expected_effect}</p>
                  </div>
                  <div className="space-y-3">
                    <div className="font-medium">Safety checks</div>
                    <ul className="space-y-1">
                      {o.l3.guard.rules.map((r) => (
                        <li key={r.rule} className="flex items-start gap-2">
                          {r.ok ? <Check className="mt-0.5 h-4 w-4 text-green-600" /> : <X className="mt-0.5 h-4 w-4 text-destructive" />}
                          <span>{r.rule}{!r.ok && <span className="block text-xs text-destructive">{r.detail}</span>}</span>
                        </li>
                      ))}
                    </ul>
                    {"error" in o.l3.requirement ? <p className="text-destructive">Requirement document: {o.l3.requirement.error}</p>
                      : <Requirement req={o.l3.requirement as FixRequirement} ticketId={ticket.id} />}
                  </div>
                </div>
                {decided ? (
                  <p className="rounded-md bg-muted p-3">
                    {run?.status === "approved" ? "Approved" : "Rejected"} by <b>{o.decision?.approver}</b>
                    {o.decision?.change_id && <> under {o.decision.change_id}</>}. Script fingerprint (SHA-256): <code className="text-xs">{o.decision?.script_sha256.slice(0, 16)}…</code>. Not executed by this app.
                  </p>
                ) : (
                  <Decision ticketId={ticket.id} runBy={user} onDone={reload} onError={setError}
                    onApproveBlocked={!o.l3.guard.passed} />
                )}
              </>
            )}
          </>
        )}
        {(done("l1") || done("l2") || done("l3")) && (
          <CloseTicket ticketId={ticket.id} run={run!} user={user} onDone={reload} onError={setError} />
        )}
        <div className="flex items-center gap-2 border-t border-border pt-3 text-xs text-muted-foreground">
          Working as <Input className="h-7 w-32" value={user} onChange={(e) => setUser(e.target.value)} aria-label="Your name" />
        </div>
      </div>
    </section>
    <SimilarTicketsPanel result={run?.outputs.similar} loading={busy === "l1"} />
    </>
  );
}

const RTYPES = ["ConfigChange", "CodeFix", "PatchApplied", "RestartRecycle", "DataRemediation",
  "VendorEscalation", "Workaround", "UserErrorClosed", "NoActionByDesign"];
const LEVEL_DEFAULT: Record<string, string> = { l1: "UserErrorClosed", l2: "Workaround", l3: "DataRemediation" };
const field = "mt-1 w-full rounded-md border border-input bg-background px-3 py-2 text-sm";

function draftNotes(level: string, run: FixRun): string {
  const o = run.outputs;
  if (level === "l1") return `Resolved at L1 with guided steps from ${o.card?.article_id ?? "the knowledge card"}: ${o.card?.title ?? ""}.`;
  if (level === "l2") return o.l2?.conclusion ?? "";
  const d = o.decision;
  return `${o.l2?.conclusion ?? ""} Fix: ${o.l3?.explanation ?? ""}${d?.change_id ? ` Approved under ${d.change_id}.` : ""}`.trim();
}

function CloseTicket({ ticketId, run, user, onDone, onError }:
  { ticketId: string; run: FixRun; user: string; onDone: () => Promise<void>; onError: (m: string) => void }) {
  const levels = (["l1", "l2", "l3"] as const).filter((l) => Boolean(run.outputs[l]));
  const top = levels[levels.length - 1];
  const [level, setLevel] = useState<string>(top);
  const [rtype, setRtype] = useState(LEVEL_DEFAULT[top]);
  const [notes, setNotes] = useState(() => draftNotes(top, run));
  const [busy, setBusy] = useState(false);
  const res = run.outputs.resolution;

  if (run.status === "closed" && res) {
    return (
      <div className="space-y-1 rounded-md border border-slate-300 bg-slate-50 p-4">
        <div className="flex items-center gap-2 font-semibold text-slate-900"><Check className="h-4 w-4 text-green-600" />Ticket closed at {res.level.toUpperCase()} by {res.resolved_by}</div>
        <div className="text-xs text-muted-foreground">Resolution type: {res.resolution_type}</div>
        <p>{res.notes}</p>
        <p className="text-xs text-muted-foreground">
          {res.embedded ? "Saved to the ticket store and embedded, so it now appears in similar-ticket search."
            : res.ticket_store ? "Saved, but the embedding service was unavailable. It will not appear in similar-ticket search yet."
            : "Recorded in the workbench. This ticket is not in the ticket store, so it was not embedded."}
        </p>
      </div>
    );
  }
  const pick = (l: string) => { setLevel(l); setRtype(LEVEL_DEFAULT[l]); setNotes(draftNotes(l, run)); };
  const l3Blocked = level === "l3" && run.status !== "approved";
  const submit = async () => {
    onError(""); setBusy(true);
    try { await resolveFix(ticketId, { level, resolution_type: rtype, notes, resolved_by: user }); await onDone(); }
    catch (e) { onError(e instanceof Error ? e.message : "Failed"); }
    finally { setBusy(false); }
  };
  return (
    <div className="space-y-3 rounded-md border border-border bg-muted/30 p-4">
      <div className="font-semibold text-[#0B2A4A]">Resolve and close ticket</div>
      <div className="grid gap-3 sm:grid-cols-2">
        <label className="text-xs">Resolved at
          <select className={field} value={level} onChange={(e) => pick(e.target.value)}>
            {levels.map((l) => <option key={l} value={l}>{l.toUpperCase()}</option>)}
          </select></label>
        <label className="text-xs">Resolution type
          <select className={field} value={rtype} onChange={(e) => setRtype(e.target.value)}>
            {RTYPES.map((t) => <option key={t} value={t}>{t}</option>)}
          </select></label>
      </div>
      <label className="block text-xs">Resolution notes
        <textarea className={field} rows={3} value={notes} onChange={(e) => setNotes(e.target.value)} /></label>
      {l3Blocked && <p className="text-xs text-amber-800">Approve the L3 fix above before closing with L3, or choose L1 or L2.</p>}
      <Button onClick={submit} disabled={busy || l3Blocked || !notes.trim() || !user.trim()}>
        {busy && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Close ticket and save to knowledge
      </Button>
    </div>
  );
}

function Run({ label, busy, onClick, disabled }: { label: string; busy: boolean; onClick: () => void; disabled?: boolean }) {
  return (
    <Button onClick={onClick} disabled={busy || disabled}>
      {busy && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}{busy ? "Working…" : label}
    </Button>
  );
}

function Requirement({ req, ticketId }: { req: FixRequirement; ticketId: string }) {
  return (
    <div className="space-y-2 rounded-md border border-border p-3">
      <div className="font-medium">Change requirement (permanent fix)</div>
      <div>{req.title}</div>
      <ul className="list-disc pl-5 text-xs">{req.acceptance_criteria.map((a) => <li key={a}>{a}</li>)}</ul>
      <div className="flex gap-2">
        <a className="inline-flex items-center gap-1 text-xs text-primary underline" href={`/api/fix/${ticketId}/requirement.md`} download={`requirement-${ticketId}.md`}><Download className="h-3 w-3" />Markdown</a>
        <a className="inline-flex items-center gap-1 text-xs text-primary underline" href={`/api/fix/${ticketId}/requirement.json`} download={`requirement-${ticketId}.json`}><Download className="h-3 w-3" />JSON</a>
      </div>
    </div>
  );
}

function Decision({ ticketId, runBy, onDone, onError, onApproveBlocked }:
  { ticketId: string; runBy: string; onDone: () => Promise<void>; onError: (m: string) => void; onApproveBlocked: boolean }) {
  const [approver, setApprover] = useState("");
  const [change, setChange] = useState("");
  const submit = async (kind: "approve" | "reject") => {
    onError("");
    try { await decideFix(ticketId, kind, { approver, change_id: change }); await onDone(); }
    catch (e) { onError(e instanceof Error ? e.message : "Failed"); }
  };
  return (
    <div className="flex flex-wrap items-end gap-3 border-t border-border pt-4">
      <label className="text-xs">Approver (not {runBy})<Input className="mt-1 w-44" value={approver} onChange={(e) => setApprover(e.target.value)} /></label>
      <label className="text-xs">Change-control id<Input className="mt-1 w-40" placeholder="CHG-2041" value={change} onChange={(e) => setChange(e.target.value)} /></label>
      <Button variant="outline" onClick={() => submit("reject")}>Reject</Button>
      <Button onClick={() => submit("approve")} disabled={onApproveBlocked}>Approve for change control</Button>
    </div>
  );
}
