python3 - <<'EOF'
from dotenv import dotenv_values
import psycopg

config = dotenv_values('/home/JarvisClaims/Musaddique/Smart Renewal Advisor/.env')
url = config['DATABASE_URL'].split('?')[0]
conn = psycopg.connect(url, sslmode='require')
cur = conn.cursor()

tables = ['src.customer','src.policy','src.policy_module','src.insured_vehicle',
          'src.insured_property','src.insured_animal','src.claim','src.complaint',
          'src.consent','src.customer_declared_fact','src.rating_quote','src.renewal_quote']

for t in tables:
    schema, table = t.split('.')
    cur.execute("""
        SELECT column_name, data_type, is_nullable
        FROM information_schema.columns
        WHERE table_schema=%s AND table_name=%s
        ORDER BY ordinal_position
    """, (schema, table))
    cols = cur.fetchall()
    print(f"\n=== {t} ===")
    for col in cols:
        nullable = 'NULL' if col[2]=='YES' else 'NOT NULL'
        print(f"  {col[0]} ({col[1]}) {nullable}")

cur.close()
conn.close()
EOF
