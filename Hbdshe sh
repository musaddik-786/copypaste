def _is_motor(lob) -> bool:
    return (lob or "").strip().lower() == "motor"

def _t(lob) -> str:
    """Main submission table name for the given LOB."""
    return "motor_fnol_submissions" if _is_motor(lob) else "fnol_submissions"

def _child(lob) -> dict:
    """Child table names keyed by role for the given LOB."""
    if _is_motor(lob):
        return {
            "ai":         "motor_fnol_ai_inferences",
            "extraction": "motor_fnol_voice_text_extraction",
            "questions":  "motor_fnol_mandatory_question_log",
            "attribution":"motor_fnol_field_attribution",
            "mandatory":  "motor_fnol_mandatory_fields",
        }
    return {
        "ai":         "fnol_ai_inferences",
        "extraction": "fnol_voice_text_extraction",
        "questions":  "fnol_mandatory_question_log",
        "attribution":"fnol_field_attribution",
        "mandatory":  "fnol_mandatory_fields",
    }

