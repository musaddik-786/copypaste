SELECT
    c.claim_number,
    c.gw_claim_id,
    c.loss_type,
    pd.policy_address,
    pd.city,
    pd.state,
    af.adjusted_reserve,
    le.net_payable
FROM claims c
LEFT JOIN policy_details pd ON pd.policy_number = c.policy_number
LEFT JOIN adjuster_findings af ON af.claim_id = c.claim_number
LEFT JOIN loss_estimation_outputs le ON le.claim_id = c.claim_number
WHERE c.gw_claim_id IS NOT NULL;
