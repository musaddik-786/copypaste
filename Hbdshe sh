SELECT 'chat_rca_records' AS tbl, severity, curation_status, (embedding IS NULL) AS no_embedding, count(*)
FROM chat_rca_records
WHERE severity IN ('Emergency','High')
GROUP BY severity, curation_status, no_embedding
UNION ALL
SELECT 'release_note_records', severity, curation_status, (embedding IS NULL), count(*)
FROM release_note_records
WHERE severity IN ('Emergency','High')
GROUP BY severity, curation_status, no_embedding;
