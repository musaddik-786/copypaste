"""Ticket Classification & Triage Agent: tags/retags a ticket_records row via the LLM.

This is what clears the 'NeedsRetag' status every osTicket-synced ticket starts
with (see app/services/osticket.py) -- it never touches the sync itself, only
the tagging fields the sync deliberately leaves as placeholders.
"""
from fastapi import APIRouter, HTTPException

from app.services.classification import ClassificationInput, classify_ticket
from backend.taxonomy import AUTO_APPROVE_CONFIDENCE_THRESHOLD

router = APIRouter(prefix="/api/classify")


def _pg():
    from app.routers.tickets import get_conn
    return get_conn()


FETCH_SQL = """SELECT record_id, source_ref_id, title, raw_text, resolution, curation_status, source_metadata
 FROM ticket_records
 WHERE record_id = %s AND COALESCE(source_metadata ->> 'removed', 'false') <> 'true'"""

UPDATE_SQL = """UPDATE ticket_records SET
 module = %(module)s, category = %(category)s, severity = %(severity)s,
 resolution_type = %(resolution_type)s, tagging_confidence = %(confidence)s,
 tagging_reasoning = %(reasoning)s, curation_status = %(curation_status)s, upserted_at = now()
 WHERE record_id = %(record_id)s
 RETURNING record_id, module, category, severity, resolution_type, tagging_confidence,
           tagging_reasoning, curation_status"""


@router.post("/{record_id}")
def classify(record_id: str) -> dict:
    with _pg() as c:
        row = c.execute(FETCH_SQL, (record_id,)).fetchone()
    if not row:
        raise HTTPException(404, "Ticket not found")

    meta = row["source_metadata"] or {}
    try:
        result = classify_ticket(ClassificationInput(
            ticket_id=row["source_ref_id"],
            title=row["title"],
            description=row["raw_text"],
            priority=meta.get("priority"),
            status=meta.get("status"),
            resolution_notes=row.get("resolution"),
        ))
    except RuntimeError as exc:
        raise HTTPException(502, str(exc)) from exc
    except ValueError as exc:
        raise HTTPException(503, f"Agent configuration error: {exc}") from exc

    curation_status = (
        "AutoApproved" if result.confidence >= AUTO_APPROVE_CONFIDENCE_THRESHOLD else "PendingReview"
    )
    params = {
        "record_id": record_id,
        "module": result.module.value,
        "category": result.category.value,
        "severity": result.severity.value,
        "resolution_type": result.resolution_type.value if result.resolution_type else None,
        "confidence": result.confidence,
        "reasoning": result.reasoning,
        "curation_status": curation_status,
    }
    with _pg() as c:
        updated = c.execute(UPDATE_SQL, params).fetchone()
    if not updated:
        raise HTTPException(404, "Ticket not found")

    return {**updated, "summary": result.summary, "severity_source": result.severity_source}
