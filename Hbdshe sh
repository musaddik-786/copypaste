python3 -c "
path = 'server.py'
with open(path) as f:
    content = f.read()

old = '            headers={\"api_key\": PHOENIX_API_KEY} if PHOENIX_API_KEY else {},'
new = '            headers={\"Authorization\": f\"Bearer {PHOENIX_API_KEY}\"} if PHOENIX_API_KEY else {},'

if old in content:
    with open(path, 'w') as f:
        f.write(content.replace(old, new))
    print('Updated!')
else:
    print('No match')
"
