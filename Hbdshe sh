# ──────────────────────────────────────────────────────────────────────────────
# Loss type canonicalization
# ──────────────────────────────────────────────────────────────────────────────
# Motor LOB canonical loss types — must match the options seeded in
# fnol_mandatory_fields. Freeform user text is normalised to one of these
# values before being stored so the DB stays consistent.
_CANONICAL_LOSS_TYPES = [
    "Collision", "Theft", "Vandalism", "Fire",
    "Natural Disaster", "Third-Party Liability", "Windshield Damage",
]

_LOSS_TYPE_KEYWORD_MAP = {
    "Collision": ["collision", "crash", "accident", "hit", "impact", "rear-end", "rear end",
                  "side-swipe", "sideswipe", "roll", "rollover", "overturn"],
    "Theft": ["theft", "stolen", "steal", "burglary", "burglar", "robbery", "break-in", "break in"],
    "Vandalism": ["vandal", "vandalism", "keyed", "graffiti", "scratch", "damage", "intentional"],
    "Fire": ["fire", "burn", "burnt", "smoke", "arson", "ignit"],
    "Natural Disaster": ["flood", "hail", "storm", "hurricane", "cyclone", "tornado", "wind",
                         "natural", "earthquake", "earthquake", "water damage", "submerged"],
    "Third-Party Liability": ["third party", "third-party", "liability", "someone else", "other vehicle",
                               "pedestrian", "cyclist", "property damage"],
    "Windshield Damage": ["windshield", "windscreen", "glass", "crack", "chip", "shatter"],
}


def _normalize_loss_type(value):
    """
    Maps a freeform loss_type string onto one of _CANONICAL_LOSS_TYPES by
    keyword match. Already-canonical values pass through unchanged. Falls
    back to the trimmed original value if nothing matches, so unrecognized
    input isn't silently discarded.
    """
    if value is None:
        return value
    trimmed = value.strip()
    if trimmed in _CANONICAL_LOSS_TYPES:
        return trimmed
    lowered = trimmed.lower()
    for canonical, keywords in _LOSS_TYPE_KEYWORD_MAP.items():
        if any(keyword in lowered for keyword in keywords):
            return canonical
    log.warning("loss_type %r did not match any canonical category — storing as-is", value)
    return trimmed


def _normalize_time_of_loss(value):
    """
    Normalizes time_of_loss to HH:MM format (24-hour).
    If value is just a single/double digit hour (e.g. "9", "14"), pads to HH:00.
    If value already looks like HH:MM, passes through.
    If value is unparseable/None, returns None.
    """
    if value is None:
        return None
    s = str(value).strip()
    if not s:
        return None
    if ":" in s:
        parts = s.split(":")
        try:
            h = int(parts[0])
            m = int(parts[1]) if len(parts) > 1 else 0
            if 0 <= h <= 23 and 0 <= m <= 59:
                return f"{h:02d}:{m:02d}"
        except (ValueError, IndexError):
            pass
    else:
        try:
            h = int(s)
            if 0 <= h <= 23:
                return f"{h:02d}:00"
        except ValueError:
            pass
    log.warning("time_of_loss %r could not be normalized to HH:MM — storing as-is", value)
    return s


