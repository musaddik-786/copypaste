### 3. Proposed `recovery_mcp/handler.py`

**Baseline version — deliberately ignores prior erosion.**

```python
import logging
from decimal import Decimal
from typing import Optional

from common.db import get_db_connection
from psycopg2.extras import RealDictCursor

log = logging.getLogger(__name__)


def get_event(event_ref: str) -> dict:
    connection = None
    cursor = None
    try:
        connection = get_db_connection()
        cursor = connection.cursor(cursor_factory=RealDictCursor)
        cursor.execute(
            """
            SELECT event_ref, event_name, peril, event_date,
                   total_gross_loss, total_net_retained_loss,
                   affected_policy_count, cat_programme_ref, exclusion_note
            FROM loss_events
            WHERE event_ref = %s
            """,
            (event_ref,),
        )
        row = cursor.fetchone()
        if not row:
            return {"status": "not_found", "message": f"Event {event_ref} not found"}
        return {"status": "success", "data": dict(row)}
    except Exception:
        log.exception("get_event failed for %s", event_ref)
        raise
    finally:
        if cursor:
            cursor.close()
        if connection:
            connection.close()


def calculate_xol_recovery(
    event_ref: str,
    treaty_ref: str,
    layer_number: int,
    as_at_date: Optional[str] = None,
) -> dict:
    """
    BASELINE — deliberately uses treaty_terms.layer_limit without
    checking prior erosion from layer_erosion.
    Known limitation: overstates recovery when a layer has prior erosion.
    Improvement: read current_limit_remaining from layer_erosion (next iteration).
    """
    connection = None
    cursor = None
    try:
        connection = get_db_connection()
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        # Step 1: Get the loss event
        cursor.execute(
            """
            SELECT total_net_retained_loss, peril, affected_policy_count
            FROM loss_events
            WHERE event_ref = %s
            """,
            (event_ref,),
        )
        event = cursor.fetchone()
        if not event:
            return {"status": "not_found", "message": f"Event {event_ref} not found"}

        net_retained_loss = Decimal(str(event["total_net_retained_loss"]))

        # Step 2: Get treaty layer terms
        cursor.execute(
            """
            SELECT attachment_point, layer_limit, event_limit, aggregate_limit
            FROM treaty_terms
            WHERE treaty_ref = %s AND layer_number = %s
            """,
            (treaty_ref, layer_number),
        )
        terms = cursor.fetchone()
        if not terms:
            return {
                "status": "not_found",
                "message": f"No terms for {treaty_ref} layer {layer_number}",
            }

        attachment = Decimal(str(terms["attachment_point"]))
        layer_limit = Decimal(str(terms["layer_limit"]))
        event_limit = Decimal(str(terms["event_limit"]))

        # Step 3: Naive calculation — uses original layer_limit, no erosion
        # DELIBERATE BASELINE: does not read current_limit_remaining
        effective_limit = min(layer_limit, event_limit)
        loss_above_attachment = max(Decimal("0"), net_retained_loss - attachment)
        recoverable = min(loss_above_attachment, effective_limit)

        calculation_basis = {
            "method": "naive_xol_baseline_v1",
            "warning": "BASELINE — does not account for prior layer erosion",
            "event_ref": event_ref,
            "treaty_ref": treaty_ref,
            "layer_number": layer_number,
            "net_retained_loss": str(net_retained_loss),
            "attachment_point": str(attachment),
            "layer_limit_at_inception": str(layer_limit),
            "event_limit": str(event_limit),
            "effective_limit_used": str(effective_limit),
            "loss_above_attachment": str(loss_above_attachment),
            "recoverable_amount": str(recoverable),
        }

        return {
            "status": "success",
            "recoverable_amount": float(recoverable),
            "calculation_basis": calculation_basis,
        }

    except Exception:
        log.exception(
            "calculate_xol_recovery failed for %s / %s layer %s",
            event_ref, treaty_ref, layer_number,
        )
        raise
    finally:
        if cursor:
            cursor.close()
        if connection:
            connection.close()


def calculate_aggregate_position(
    treaty_ref: str,
    layer_number: int,
    as_at_date: str,
) -> dict:
    """
    Reads layer_erosion ordered by event_date to return the current
    available limit before as_at_date.
    This IS the correct implementation — this function is not the
    deliberate wrong turn; calculate_xol_recovery is.
    """
    connection = None
    cursor = None
    try:
        connection = get_db_connection()
        cursor = connection.cursor(cursor_factory=RealDictCursor)

        cursor.execute(
            """
            SELECT event_ref, event_date, amount_eroded,
                   cumulative_eroded, current_limit_remaining,
                   aggregate_remaining
            FROM layer_erosion
            WHERE treaty_ref = %s
              AND layer_number = %s
              AND event_date < %s
            ORDER BY event_date DESC
            LIMIT 1
            """,
            (treaty_ref, layer_number, as_at_date),
        )
        erosion = cursor.fetchone()

        if not erosion:
            cursor.execute(
                """
                SELECT layer_limit, aggregate_limit
                FROM treaty_terms
                WHERE treaty_ref = %s AND layer_number = %s
                """,
                (treaty_ref, layer_number),
            )
            terms = cursor.fetchone()
            if not terms:
                return {
                    "status": "not_found",
                    "message": f"No terms for {treaty_ref} layer {layer_number}",
                }
            return {
                "status": "success",
                "data": {
                    "treaty_ref": treaty_ref,
                    "layer_number": layer_number,
                    "as_at_date": as_at_date,
                    "cumulative_eroded": 0.0,
                    "current_limit_remaining": float(terms["layer_limit"]),
                    "aggregate_remaining": float(terms["aggregate_limit"]),
                    "prior_events": 0,
                },
            }

        return {
            "status": "success",
            "data": {
                "treaty_ref": treaty_ref,
                "layer_number": layer_number,
                "as_at_date": as_at_date,
                "cumulative_eroded": float(erosion["cumulative_eroded"]),
                "current_limit_remaining": float(erosion["current_limit_remaining"]),
                "aggregate_remaining": float(erosion["aggregate_remaining"]),
                "most_recent_prior_event": erosion["event_ref"],
            },
        }

    except Exception:
        log.exception(
            "calculate_aggregate_position failed for %s layer %s as_at %s",
            treaty_ref, layer_number, as_at_date,
        )
        raise
    finally:
        if cursor:
            cursor.close()
        if connection:
            connection.close()
```

