# ──────────────────────────────────────────────────────────────────────────────
# Motor LOB — Vehicle Details (pre-populated from table, never asked from user)
# ──────────────────────────────────────────────────────────────────────────────

def get_motor_vehicle_details(policy_number: str) -> List[dict]:
    """
    Return ALL pre-populated vehicles for *policy_number* from the
    motor_vehicle_details table, oldest first. A policy may have more than
    one vehicle (see 54-847564 seed data) — these fields (driver_license,
    vin, registration_number, make/model/year) are seeded from back-office
    data and must NOT be asked from the policyholder; only WHICH of these
    vehicles applies to this claim may need to be asked/confirmed, via
    select_motor_vehicle, when the list has more than one entry and the
    description doesn't unambiguously name one.
    Returns an empty list if no vehicle exists for the policy.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            "SELECT id, driver_license, vin, registration_number, "
            "vehicle_make, vehicle_model, vehicle_year "
            "FROM motor_vehicle_details WHERE policy_number = %s "
            "ORDER BY id",
            (policy_number,),
        )
        return [dict(row) for row in cur.fetchall()]
    finally:
        conn.close()


def _match_vehicle_from_text(vehicles: List[dict], raw_text: Optional[str]) -> List[dict]:
    """
    Narrow *vehicles* down to the ones referenced by *raw_text*, matching
    case-insensitively against vehicle_make, vehicle_model, registration_number,
    and vin. Used both to silently auto-resolve an unambiguous single-vehicle
    mention at FNOL creation time, and by select_motor_vehicle to resolve a
    policyholder's follow-up answer ("the Toyota", "CA-GAM-564", etc.).
    Returns the subset of vehicles that matched (may be empty, one, or more
    than one — callers decide what "more than one" / "none" means for them).
    """
    text = (raw_text or "").strip().lower()
    if not text:
        return []
    matches = []
    for v in vehicles:
        candidates = [v.get("vehicle_make"), v.get("vehicle_model"),
                      v.get("registration_number"), v.get("vin")]
        if any(c and str(c).strip().lower() in text for c in candidates):
            matches.append(v)
    return matches


def select_motor_vehicle(policy_number: str, fnol_id: int, vehicle_description: str) -> dict:
    """
    Resolve which of a policy's multiple vehicles a Motor FNOL refers to, from
    the policyholder's free-text answer (e.g. "the Toyota", "my Ford F-150",
    "CA-GAM-564"), and persist that vehicle's details onto the
    motor_fnol_submissions record identified by fnol_id.

    Returns one of:
      {"resolved": true, "vehicle": {...}, "submission": {...}}
      {"resolved": false, "reason": "no_match" | "ambiguous", "candidates": [...]}
    `candidates` lists every vehicle on the policy (id, make, model, year,
    registration_number) so the caller can ask the policyholder to pick again
    by number or by a clearer description.
    """
    vehicles = get_motor_vehicle_details(policy_number)
    if not vehicles:
        return {"resolved": False, "reason": "no_match", "candidates": []}

    matches = _match_vehicle_from_text(vehicles, vehicle_description)
    if len(matches) != 1:
        return {
            "resolved": False,
            "reason": "ambiguous" if len(matches) > 1 else "no_match",
            "candidates": [
                {k: v[k] for k in ("id", "vehicle_make", "vehicle_model", "vehicle_year", "registration_number")}
                for v in vehicles
            ],
        }

    vehicle = matches[0]
    veh_fields = {k: v for k, v in vehicle.items() if k != "id" and v is not None}
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        # Note: vehicle columns (driver_license, vin, registration_number,
        # vehicle_make/model/year) have no _source counterparts on
        # motor_fnol_submissions — unlike the loss/accident fields, they come
        # from back-office data, not the policyholder's own words.
        set_clauses = ", ".join(f"{k} = %s" for k in veh_fields)
        cur.execute(
            f"UPDATE motor_fnol_submissions SET {set_clauses}, updated_at = NOW() WHERE id = %s RETURNING *",
            list(veh_fields.values()) + [fnol_id],
        )
        result = cur.fetchone()
        if not result:
            conn.rollback()
            raise ValueError(f"motor_fnol_submissions id {fnol_id} not found")
        conn.commit()
        return {"resolved": True, "vehicle": vehicle, "submission": row_to_dict(result)}
    except Exception:
        conn.rollback()
        log.exception("select_motor_vehicle failed for fnol_id %s", fnol_id)
        raise
    finally:
        conn.close()


