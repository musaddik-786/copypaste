// Shapes mirror the real `ticket_records` table in the Knowledgeops_gw
// Postgres DB (see server/index.js: GET /api/tickets) — no stubbed fields.

export type CurationStatus =
  | "PendingReview"
  | "AutoApproved"
  | "SMEApproved"
  | "SMERejected"
  | "NeedsRetag";

export type Severity = "Emergency" | "High" | "Normal" | "Low";

export type ResolutionType =
  | "ConfigChange"
  | "CodeFix"
  | "PatchApplied"
  | "RestartRecycle"
  | "DataRemediation"
  | "VendorEscalation"
  | "Workaround"
  | "UserErrorClosed"
  | "NoActionByDesign";

export interface TicketSourceMetadata {
  new_unclassified?: boolean;
  priority?: string;
  assignee_team?: string;
  created_at?: string;
  closed_at?: string | null;
}

/** Raw row shape as returned by GET /api/tickets (snake_case, straight from Postgres). */
export interface TicketRecordRow {
  record_id: string;
  source_ref_id: string;
  module: string;
  category: string;
  severity: Severity;
  resolution_type: ResolutionType | null;
  tagging_confidence: number;
  tagging_reasoning: string | null;
  classification_summary: string | null;
  title: string;
  raw_text: string;
  structured_sop: string | null;
  guidewire_version: string | null;
  event_date: string;
  source_metadata: TicketSourceMetadata | null;
  curation_status: CurationStatus;
  curation_notes: string | null;
  kb_version: string | null;
  ingested_at: string;
  source_url: string | null;
}

/** Normalized camelCase shape used throughout the React UI. */
export interface Ticket {
  recordId: string;
  id: string;
  title: string;
  description: string;
  module: string;
  category: string;
  severity: Severity;
  resolutionType: ResolutionType | null;
  taggingConfidence: number;
  taggingReasoning: string | null;
  classificationSummary: string | null;
  curationStatus: CurationStatus;
  priority: string | null;
  assigneeTeam: string | null;
  createdAt: string | null;
  closedAt: string | null;
  guidewireVersion: string | null;
  eventDate: string;
  sourceUrl: string | null;
  newUnclassified: boolean;
}

/** Result of POST /api/classify/{recordId} -- also the new persisted tagging fields. */
export interface ClassificationResult {
  record_id: string;
  category: string;
  severity: Severity;
  summary: string;
  resolution_type: ResolutionType | null;
  confidence: number;
  reasoning: string;
  curation_status: CurationStatus;
  severity_source: "priority" | "model";
}

export function classificationToTicketPatch(r: ClassificationResult): Partial<Ticket> & { recordId: string } {
  return {
    recordId: r.record_id,
    category: r.category,
    severity: r.severity,
    resolutionType: r.resolution_type,
    taggingConfidence: r.confidence,
    taggingReasoning: r.reasoning,
    classificationSummary: r.summary,
    curationStatus: r.curation_status,
    newUnclassified: false,
  };
}

export function mapTicketRow(row: TicketRecordRow): Ticket {
  const meta = row.source_metadata ?? {};
  return {
    recordId: row.record_id,
    id: row.source_ref_id,
    title: row.title,
    description: row.raw_text,
    module: row.module,
    category: row.category,
    severity: row.severity,
    resolutionType: row.resolution_type,
    taggingConfidence: row.tagging_confidence,
    taggingReasoning: row.tagging_reasoning,
    classificationSummary: row.classification_summary,
    curationStatus: row.curation_status,
    priority: meta.priority ?? null,
    assigneeTeam: meta.assignee_team ?? null,
    createdAt: meta.created_at ?? null,
    closedAt: meta.closed_at ?? null,
    guidewireVersion: row.guidewire_version,
    eventDate: row.event_date,
    sourceUrl: row.source_url ?? null,
    newUnclassified: meta.new_unclassified === true,
  };
}

/**
* A ticket created from the UI. This is NOT persisted to the database yet —
* the backend API for ticket creation is still being decided (MCP vs FastAPI).
* It is held client-side only until that backend contract exists.
*/
export interface NewTicketInput {
  ticketId: string;
  createdAt: string;
  closedAt: string | null;
  issueTitle: string;
  summary: string;
  description: string;
  module: string;
  assigneeTeam: string;
  priority: string;
  complexity: string;
  createdBy: string;
}

export interface SimilarMatch {
  id: string;
  rank: number;
  match_strength: string;
  why_similar: string;
  what_differs: string;
  reusable_info: string;
  missing_info: string[] | string;
  ticket: {
    description: string | null;
    system: string | null;
    created: string | null;
    closed: string | null;
    severity: string | null;
    resolution: string | null;
    rca: string | null;
    runbook_link: string | null;
    assignee_team: string | null;
  };
}

export interface SimilarResult {
  new_ticket_assessment: unknown;
  matches: SimilarMatch[];
  no_confident_match: boolean;
  suggested_next_step: string;
}

export interface SimilarQuery {
  id?: string;
  title?: string;
  description?: string;
  module?: string;
  severity?: string;
  created?: string;
}

export interface KbCard {
  title: string;
  category: string;
  play: string;
  root_cause_codes: string[];
  symptoms: string[];
  cause: string;
  info_to_collect: string[];
  diagnosis: string[];
  resolution: string[];
  workaround: string;
  permanent_fix: string;
  escalation: string;
  related_tickets: string[];
}

export interface KbResolveResult {
  matched: boolean;
  verified: boolean;
  confidence: "high" | "medium" | "low" | null;
  reason: string;
  missing_info: string[];
  unit: { unit_id: string; article_id: string; version: string; kb_version: string | null; content: KbCard } | null;
  candidates: { unit_id: string; title: string }[];
}

export interface FixCard {
  matched?: boolean;
  title?: string;
  article_id?: string;
  play?: string;
  reason?: string;
  missing_info?: string[];
  candidates?: { unit_id: string; title: string }[];
}
export interface FixL1 {
  items: { item: string; answered: boolean; found: string }[];
  missing_count: number;
  requester_reply: string;
  escalation: string;
}
export interface FixEvidence {
  unit_id: string;
  policy_number: string;
  audit_job: string;
  checks: { id: string; description: string; query: string; result: string; facts: Record<string, unknown> }[];
}
export interface FixL2 {
  checks: { id: string; what: string; query: string; found: string; ok: boolean }[];
  conclusion: string;
  needs_data_fix: boolean;
  confidence: string;
  evidence_label: string;
}
export interface FixRequirement {
  title: string; problem: string; root_cause: string; evidence: string[]; acceptance_criteria: string[];
  impacted_modules: string[]; test_scenarios: string[]; risk: string; linked_tickets: string[];
  source_ticket: string; source_card: string;
}
export interface FixL3 {
  gosu: string;
  explanation: string;
  expected_effect: string;
  guard: { passed: boolean; rules: { rule: string; ok: boolean; detail: string }[] };
  repairs: number;
  requirement: FixRequirement | { error: string };
}
export interface FixResolution {
  level: string; resolution_type: string; notes: string; resolved_by: string;
  ticket_store?: boolean; embedded?: boolean; embed_error?: string;
}
export interface FixDecision { approver: string; change_id: string; note: string; script_sha256: string }
export interface FixRun {
  ticket_id: string;
  stage: string;
  status: string;
  run_by: string | null;
  outputs: { card?: FixCard; l1?: FixL1; evidence?: FixEvidence; l2?: FixL2; l3?: FixL3; similar?: SimilarResult; decision?: FixDecision; resolution?: FixResolution };
}
export interface FixAuditRow { ticket_id: string; action: string; actor: string | null; detail: Record<string, unknown>; created_at?: string }
