"""
db.py
─────
PostgreSQL connection helper.
Connects to Azure Database for PostgreSQL using psycopg2.

Required env vars:
    AZURE_PG_HOST      — e.g. your-server.postgres.database.azure.com
    AZURE_PG_PORT      — default 5432
    AZURE_PG_DATABASE  — e.g. claims_db
    AZURE_PG_USER      — e.g. adminuser@your-server
    AZURE_PG_PASSWORD  — password
    AZURE_PG_SSLMODE   — default "require"
"""

import logging
import os

import psycopg2
import psycopg2.extras
from dotenv import load_dotenv, find_dotenv

load_dotenv(find_dotenv())

log = logging.getLogger(__name__)

PG_HOST = os.getenv("AZURE_PG_HOST", "localhost")
PG_PORT = int(os.getenv("AZURE_PG_PORT", "5432"))
PG_DATABASE = os.getenv("AZURE_PG_DATABASE", "claims_db")
PG_USER = os.getenv("AZURE_PG_USER", "postgres")
PG_PASSWORD = os.getenv("AZURE_PG_PASSWORD", "")
PG_SSLMODE = os.getenv("AZURE_PG_SSLMODE", "require")


def get_db_connection():
    """Returns a psycopg2 connection to Azure PostgreSQL with RealDictCursor."""
    conn = psycopg2.connect(
        host=PG_HOST,
        port=PG_PORT,
        dbname=PG_DATABASE,
        user=PG_USER,
        password=PG_PASSWORD,
        sslmode=PG_SSLMODE,
        cursor_factory=psycopg2.extras.RealDictCursor,
    )
    conn.autocommit = False
    return conn


def row_to_dict(row):
    """Converts a psycopg2 RealDictRow (or list of rows) into plain dict(s)."""
    if row is None:
        return None
    if isinstance(row, list):
        return [dict(r) for r in row]
    return dict(row)


def resolve_repair_vs_replacement(cur, claim_id: str) -> dict:
    """
    Determines whether Replacement or Repair is correct for a claim.

    Priority: adjuster's explicit saved decision in repair_vs_replacement_decisions.decision
    trumps cost-math. Cost-math is used only when no explicit decision exists.

    Formula (cost-math fallback):
      repair_net  = (parts + labor) − round(parts × dep% / 100) − deductible
      replace_net = replace_total − deductible  (no depreciation on new items)
      is_replacement = replace_net < repair_net  (strictly cheaper)

    Returns a dict:
      is_replacement  — bool: True if replacement is the active decision
      repair_net      — float
      replace_net     — float | None  (None if no replacement_costs rows)
      replace_total   — float
      deductible      — float
    """
    # Check adjuster's explicit saved decision first
    try:
        cur.execute(
            "SELECT decision FROM repair_vs_replacement_decisions "
            "WHERE claim_id = %s ORDER BY id DESC LIMIT 1",
            (claim_id,),
        )
        rvr_row = cur.fetchone()
        adj_decision = (dict(rvr_row).get("decision") if rvr_row and hasattr(rvr_row, "keys") else (rvr_row[0] if rvr_row else None)) or ""
        adj_decision = str(adj_decision).strip().lower()
    except Exception:
        adj_decision = ""

    # Fetch loss_assessments for repair figures
    cur.execute(
        "SELECT total_parts_cost, total_labor_cost, depreciation_percent, deductible "
        "FROM loss_assessments WHERE claim_number = %s ORDER BY id DESC LIMIT 1",
        (claim_id,),
    )
    la = cur.fetchone()
    if la:
        la = dict(la) if hasattr(la, "keys") else {}
    else:
        la = {}

    parts = float(la.get("total_parts_cost") or 0)
    labor = float(la.get("total_labor_cost") or 0)
    dep_pct = float(la.get("depreciation_percent") or 0)
    deductible = float(la.get("deductible") or 0)
    depreciation = round(parts * dep_pct / 100)
    repair_net = max(0.0, (parts + labor) - depreciation - deductible)

    # Fetch replacement_costs total
    cur.execute(
        "SELECT SUM(total_replacement_estimate) AS rt FROM replacement_costs "
        "WHERE item_id LIKE %s",
        (f"DMG-{claim_id}-%",),
    )
    rt_row = cur.fetchone()
    replace_total = float((dict(rt_row).get("rt") if rt_row and hasattr(rt_row, "keys") else (rt_row[0] if rt_row else None)) or 0)

    replace_net = max(0.0, replace_total - deductible) if replace_total > 0 else None

    # Adjuster's explicit choice wins; fall back to cost-math only when no
    # explicit decision exists ("adjuster review" or empty).
    if adj_decision == "replace" or adj_decision == "replacement":
        is_replacement = True
    elif adj_decision == "repair":
        is_replacement = False
    else:
        # Cost-math: replacement wins only when it strictly costs the insurer less
        is_replacement = replace_net is not None and replace_net < repair_net

    return {
        "is_replacement": is_replacement,
        "repair_net": repair_net,
        "replace_net": replace_net,
        "replace_total": replace_total,
        "deductible": deductible,
    }
