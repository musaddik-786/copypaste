from pathlib import Path
import chromadb


CHROMA_PATH = Path(__file__).resolve().parent / "chroma_db"
COLLECTION_NAME = "treaty_clauses"


def get_chroma_client():
    return chromadb.PersistentClient(path=str(CHROMA_PATH))


def get_chroma_collection():
    client = get_chroma_client()
    return client.get_or_create_collection(
        name=COLLECTION_NAME
    )


def rebuild_chroma_collection():
    client = get_chroma_client()

    try:
        client.delete_collection(COLLECTION_NAME)
        print(f"Deleted existing collection: {COLLECTION_NAME}")
    except Exception:
        print(f"No existing collection found: {COLLECTION_NAME}")

    collection = client.create_collection(
        name=COLLECTION_NAME
    )

    print(f"Created fresh collection: {COLLECTION_NAME}")

    return collection


import re
from pathlib import Path

from ingestion.loaders import load_pdf
from ingestion.clause_chunker import chunk_documents
from ingestion.embedder import get_embeddings
from ingestion.chroma_store import rebuild_chroma_collection


TREATY_PDF_DIR = Path("treaty_pdfs")


def extract_treaty_ref(file_path: Path) -> str:
    filename = file_path.name

    match = re.match(
        r"(TRT-\d{4}-\d{3})",
        filename
    )

    if not match:
        raise ValueError(
            f"Could not extract treaty_ref from filename: {filename}"
        )

    return match.group(1)


def ingest_treaties():
    pdf_files = sorted(TREATY_PDF_DIR.glob("*.pdf"))

    if not pdf_files:
        raise FileNotFoundError(
            f"No treaty PDFs found in {TREATY_PDF_DIR}"
        )

    collection = rebuild_chroma_collection()

    embedding_model = get_embeddings()

    total_chunks = 0

    for pdf_path in pdf_files:

        treaty_ref = extract_treaty_ref(pdf_path)

        print(f"\nProcessing: {pdf_path.name}")
        print(f"Treaty ref: {treaty_ref}")

        documents = load_pdf(str(pdf_path))

        chunks = chunk_documents(documents)

        texts = [
            chunk["text"]
            for chunk in chunks
        ]

        vectors = embedding_model.embed_documents(texts)

        ids = [
            f"{treaty_ref}_{chunk['chunk_number']}"
            for chunk in chunks
        ]

        metadatas = [
            {
                "source": chunk["source"],
                "treaty_ref": treaty_ref,
                "page_number": chunk["page_number"],
                "chunk_number": chunk["chunk_number"],
                "article": chunk["article"] or "",
                "clause_ref": chunk["clause_ref"] or "",
            }
            for chunk in chunks
        ]

        collection.upsert(
            ids=ids,
            documents=texts,
            embeddings=vectors,
            metadatas=metadatas,
        )

        total_chunks += len(chunks)

        print(f"Chunks: {len(chunks)}")

    print("\n-----------------------------")
    print("Ingestion complete")
    print(f"Treaties: {len(pdf_files)}")
    print(f"Total chunks: {total_chunks}")
    print(f"Collection count: {collection.count()}")
    print("-----------------------------")


if __name__ == "__main__":
    ingest_treaties()


from ingestion.embedder import get_embeddings
from ingestion.chroma_store import get_chroma_collection


def search_clause(treaty_ref: str, query: str):

    collection = get_chroma_collection()
    embedding_model = get_embeddings()

    query_vector = embedding_model.embed_query(query)

    results = collection.query(
        query_embeddings=[query_vector],
        n_results=5,
        where={
            "treaty_ref": treaty_ref
        },
    )

    print("\n====================================")
    print(f"Treaty: {treaty_ref}")
    print(f"Query: {query}")
    print("====================================")

    for i in range(len(results["documents"][0])):

        metadata = results["metadatas"][0][i]
        document = results["documents"][0][i]
        distance = results["distances"][0][i]

        print(f"\nResult {i + 1}")
        print(f"Distance: {distance}")
        print(f"Article: {metadata['article']}")
        print(f"Clause: {metadata['clause_ref']}")
        print(f"Page: {metadata['page_number']}")
        print(f"Treaty: {metadata['treaty_ref']}")
        print(f"Text:\n{document}")


if __name__ == "__main__":

    query = "What is excluded under Article 4(b)?"

    search_clause(
        "TRT-2026-001",
        query
    )

    search_clause(
        "TRT-2026-003",
        query
    )
