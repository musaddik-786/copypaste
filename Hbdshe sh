cd ~/Musaddique/AgentVerse_Claims_motor/Jarvis_claims_agents_v3_copy_new/PolicyholderAgents

python3 - <<'EOF'
import re, os, glob

OLD_EXPORTER = '''        _exporter = _OTLPSpanExporter(
            endpoint=PHOENIX_ENDPOINT.rstrip("/") + "/v1/traces",
            headers={"api_key": PHOENIX_API_KEY} if PHOENIX_API_KEY else {},
        )
        _tracer_provider = _TracerProvider()'''

NEW_EXPORTER = '''        _exporter = _OTLPSpanExporter(
            endpoint=PHOENIX_ENDPOINT.rstrip("/") + "/v1/traces",
            headers={"Authorization": f"Bearer {PHOENIX_API_KEY}"} if PHOENIX_API_KEY else {},
        )
        from opentelemetry.sdk.resources import Resource as _Resource
        _tracer_provider = _TracerProvider(
            resource=_Resource.create({"openinference.project.name": "policyholder-agents"})
        )'''

agents = [
    "VoiceTextIntakeAgent", "PolicyCoverageVerificationAgent", "FeedbackAgent",
    "DuplicateClaimCheckAgent", "DocumentSubmissionAgent", "CommunicationAgent",
    "ClaimSegmentationAgent", "ClaimReadinessAgent", "ClaimStatusAgent",
]

for agent in agents:
    path = f"{agent}/server.py"
    if not os.path.exists(path):
        print(f"SKIP (not found): {path}")
        continue
    with open(path) as f:
        src = f.read()
    if '{"api_key": PHOENIX_API_KEY}' not in src:
        print(f"SKIP (already updated): {path}")
        continue
    new_src = src.replace(OLD_EXPORTER, NEW_EXPORTER)
    if new_src == src:
        print(f"NO MATCH: {path}")
        continue
    with open(path, "w") as f:
        f.write(new_src)
    print(f"Updated: {path}")
EOF
