# Motor LOB only: collision_type ("Rear-end", "Head-on", etc.) only makes
# sense when the loss actually involved a vehicle impact. For the other loss
# types (Theft, Vandalism, Fire, Natural Disaster, Windshield Damage) there is
# no collision mechanism to classify or ask the policyholder about, so it
# auto-resolves to "Other" instead of being left null (which would otherwise
# surface as a blocking "required field" gap on the Stage 3 review page, or
# prompt a nonsensical question like "what's the collision type?" for a
# stolen or weather-damaged vehicle).
_MOTOR_COLLISION_LOSS_TYPES = {"collision", "third-party liability"}


def _maybe_default_collision_type(loss_type, existing_collision_type) -> Optional[str]:
    lt = (loss_type or "").strip().lower()
    if not lt or lt in _MOTOR_COLLISION_LOSS_TYPES:
        return None
    if existing_collision_type and str(existing_collision_type).strip():
        return None
    return "Other"

