# WITH THIS:
_MOTOR_LOSS_CAUSE_MAP = {
    "collision":             "vehcollision",
    "theft":                 "theftentire",
    "vandalism":             "vandalism",
    "fire":                  "firedamage",
    "natural disaster":      "wind",
    "third-party liability": "vehcollision",
    "windshield damage":     "glassbreakage",
}

_HO_LOSS_CAUSE_MAP = {
    "fire":        "firedamage",
    "waterdamage": "waterdamage",
    "hurricane":   "hurricane",
    "burglary":    "burglary",
    "explosion":   "explosion",
    "earthquake":  "earthquake",
    "vandalism":   "vandalism",
    "theft":       "theftentire",
    "wind":        "wind",
    "hail":        "hail",
    "mold":        "mold",
}

def _map_loss_cause(loss_type: str | None, lob: str = "Homeowners") -> str:
    if not loss_type:
        return "miscellaneous"
    key = loss_type.strip().lower()
    mapping = _MOTOR_LOSS_CAUSE_MAP if _is_motor(lob) else _HO_LOSS_CAUSE_MAP
    return mapping.get(key, "miscellaneous")
