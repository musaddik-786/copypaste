-- Check all three tables are linked correctly
SELECT 
    c.claim_number,
    c.gw_claim_id,
    c.loss_type,
    c.short_description,
    pd.policy_address,
    pd.city,
    pd.state,
    pd.postal_code,
    f.area_affected,
    f.occupancy_at_loss,
    f.status AS fnol_status
FROM claims c
JOIN policy_details pd ON pd.policy_number = c.policy_number
JOIN fnol_submissions f ON f.policy_number = c.policy_number AND f.status = 'submitted'
WHERE c.gw_claim_id IS NOT NULL
ORDER BY f.submitted_at DESC
LIMIT 5;
