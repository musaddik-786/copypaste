async def _polling_loop():
    """
    Every POLL_INTERVAL seconds, query the DB for Motor claims awaiting
    intake validation and process each one through the agent.
    """
    logger.info("Intake validation polling loop started (interval=%ds)", POLL_INTERVAL)
    while True:
        try:
            import httpx
            async with httpx.AsyncClient(timeout=10) as client:
                resp = await client.get(
                    f"http://localhost:8500/api/v1/intake_validation/poll"
                )
                if resp.status_code == 200:
                    pending = resp.json().get("pending_claims", [])
                    if pending:
                        logger.info("Found %d claim(s) awaiting intake validation", len(pending))
                    for row in pending:
                        claim_id = row.get("claim_number")
                        if claim_id:
