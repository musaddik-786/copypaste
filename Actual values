"""
handler.py — Intake Validation
────────────────────────────────
Replicates the exact logic from the Replit app's
POST /api/intake-validation/:claimId handler (routes.ts lines 276-458).

Checks:
  1. Policy Validation    — policy exists, policy active, coverage applicable
  2. FNOL Completeness   — description, date/time, location, evidence
  3. Fraud Screening     — basic anomaly detection, prior claim frequency
  4. Completeness Score  — 7 mandatory fields, must be >= 85% to pass

On pass  → writes intake_validation_result_output, updates claim status to
           "Triage Pending" (intermediate status the MotorTriageAgent polls on)
On fail  → writes intake_validation_result_output, claim stays at
           "Claim Intake Validation"
"""

import logging
import os
import sys
import time
from datetime import datetime

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "common"))

from db import get_db_connection, row_to_dict  # noqa: E402

log = logging.getLogger(__name__)

MANDATORY_FIELDS = [
    "policy_number",
    "policyholder_name",
    "loss_type",
    "short_description",
    "location",
    "date_of_loss",
    "severity",
]


def get_motor_claim(claim_id: str) -> dict | None:
    """
    Fetch the full motor claim record (claims + motor_claim_details +
    accident_details + driver_details) for a given claim_number.
    Returns None if not found or not a Motor claim.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()

        cur.execute(
            "SELECT * FROM claims WHERE claim_number = %s",
            (claim_id,),
        )
        claim = row_to_dict(cur.fetchone())
        if not claim:
            return None

        cur.execute(
            "SELECT * FROM motor_claim_details WHERE claim_id = %s LIMIT 1",
            (claim_id,),
        )
        motor = row_to_dict(cur.fetchone())
        if not motor:
            return None  # not a motor claim

        cur.execute(
            "SELECT * FROM accident_details WHERE claim_id = %s LIMIT 1",
            (claim_id,),
        )
        accident = row_to_dict(cur.fetchone())

        cur.execute(
            "SELECT * FROM driver_details WHERE claim_id = %s LIMIT 1",
            (claim_id,),
        )
        driver = row_to_dict(cur.fetchone())

        return {
            "claim": claim,
            "motor": motor,
            "accident": accident,
            "driver": driver,
        }
    finally:
        conn.close()


def poll_pending_motor_claims() -> list[dict]:
    """
    Return all Motor claims currently in 'Claim Intake Validation' status.
    Called by the MotorIntakeValidationAgent polling loop.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT c.claim_number
            FROM   claims c
            JOIN   motor_claim_details m ON m.claim_id = c.claim_number
            WHERE  c.status = 'Claim Intake Validation'
            ORDER  BY c.filed_at ASC
            """,
        )
        rows = cur.fetchall()
        return [dict(r) for r in rows] if rows else []
    finally:
        conn.close()


def run_intake_validation(claim_id: str) -> dict:
    """
    Mirrors POST /api/intake-validation/:claimId from the Replit app exactly.

    Returns a dict with:
      outcome, completeness_score, checks, failure_reasons,
      coverage_status, fraud_risk, policy_status, new_status, validation_id
    """
    data = get_motor_claim(claim_id)
    if not data:
        raise ValueError(f"Motor claim {claim_id} not found")

    claim   = data["claim"]
    driver  = data["driver"] or {}

    checks: list[dict] = []
    blocking_failure   = False

    # ── 1. Policy Validation ─────────────────────────────────────────────────
    policy_exists      = bool(claim.get("policy_number"))
    policy_active      = True   # always true for motor (policy created at submit)
    coverage_applicable = claim.get("coverage", True) is not False

    checks.append({
        "category": "Policy Validation",
        "items": [
            {
                "check": "Policy exists",
                "passed": policy_exists,
                "detail": f"Policy {claim.get('policy_number')} found"
                          if policy_exists else "No policy number on file",
            },
            {
                "check": "Policy active",
                "passed": policy_active,
                "detail": "Policy is active and in-force",
            },
            {
                "check": "Coverage applicable",
                "passed": coverage_applicable,
                "detail": "Coverage confirmed for reported loss type"
                          if coverage_applicable
                          else "Coverage mismatch — loss type not covered",
            },
        ],
    })
    if not policy_exists or not policy_active or not coverage_applicable:
        blocking_failure = True

    # ── 2. FNOL Data Completeness ─────────────────────────────────────────────
    has_description = bool(claim.get("short_description") or claim.get("ai_generated_summary"))
    has_date_time   = bool(claim.get("date_of_loss"))
    has_location    = bool(claim.get("location"))
    image_urls      = claim.get("image_urls") or []
    has_evidence    = isinstance(image_urls, list) and len(image_urls) > 0

    checks.append({
        "category": "FNOL Data Completeness",
        "items": [
            {
                "check": "Loss description present",
                "passed": has_description,
                "detail": "Loss description provided"
                          if has_description else "Missing loss description",
            },
            {
                "check": "Date/time of loss present",
                "passed": has_date_time,
                "detail": f"Date of loss: {claim.get('date_of_loss')}"
                          if has_date_time else "Date/time of loss not provided",
            },
            {
                "check": "Location present",
                "passed": has_location,
                "detail": f"Location: {claim.get('location')}"
                          if has_location else "Loss location not provided",
            },
            {
                "check": "Minimum evidence (no photo mismatch)",
                "passed": True,
                "detail": f"{len(image_urls)} evidence item(s) attached — no mismatch detected"
                          if has_evidence else "No photographic evidence attached (not blocking)",
            },
        ],
    })
    if not has_description or not has_location:
        blocking_failure = True

    # ── 3. Fraud Screening ───────────────────────────────────────────────────
    anomaly_passed   = True
    prior_claim_ok   = True

    checks.append({
        "category": "Fraud Screening",
        "items": [
            {
                "check": "Basic anomaly detection passed",
                "passed": anomaly_passed,
                "detail": "No anomalies detected in submission pattern",
            },
            {
                "check": "Prior claim frequency check",
                "passed": prior_claim_ok,
                "detail": "Claim frequency within normal range",
            },
        ],
    })
    if not anomaly_passed:
        blocking_failure = True

    # ── 4. Completeness Score ────────────────────────────────────────────────
    completed = sum(1 for f in MANDATORY_FIELDS if claim.get(f))
    completeness_score = round((completed / len(MANDATORY_FIELDS)) * 100)

    validation_passed = (not blocking_failure) and (completeness_score >= 85)

    # ── Failure reasons ───────────────────────────────────────────────────────
    failure_reasons: list[str] = []
    if not validation_passed:
        if not has_description:
            failure_reasons.append("Missing mandatory data: loss description")
        if not has_location:
            failure_reasons.append("Missing mandatory data: location")
        if not has_date_time:
            failure_reasons.append("Missing mandatory data: date of loss")
        if not coverage_applicable:
            failure_reasons.append("Coverage mismatch")
        if not policy_active:
            failure_reasons.append("Policy inactive")
        if completeness_score < 85:
            failure_reasons.append(
                f"Data completeness score {completeness_score}% is below 85% threshold"
            )

    coverage_status = "Confirmed" if coverage_applicable else "Not Confirmed"
    fraud_risk      = "Low" if (anomaly_passed and prior_claim_ok) else "High"
    outcome         = "pass" if validation_passed else "fail"
    validation_id   = f"VAL-MT-{int(time.time())}"

    # ── Write result to DB ────────────────────────────────────────────────────
    conn = get_db_connection()
    try:
        cur = conn.cursor()

        cur.execute(
            """
            INSERT INTO intake_validation_result_output
                (validation_id, claim_id, completeness_score, coverage_status, fraud_risk, result)
            VALUES (%s, %s, %s, %s, %s, %s)
            """,
            (
                validation_id,
                claim_id,
                completeness_score,
                coverage_status,
                fraud_risk,
                "Pass" if validation_passed else "Fail",
            ),
        )

        new_status = "Claim Intake Validation"
        if validation_passed:
            # Advance to intermediate status — MotorTriageAgent polls this
            new_status = "Triage Pending"
            cur.execute(
                "UPDATE claims SET status = %s WHERE claim_number = %s",
                (new_status, claim_id),
            )

        conn.commit()
        log.info(
            "intake_validation claim=%s outcome=%s completeness=%s%% status=%s",
            claim_id, outcome, completeness_score, new_status,
        )
    except Exception:
        conn.rollback()
        log.exception("intake_validation DB write failed for claim=%s", claim_id)
        raise
    finally:
        conn.close()

    return {
        "claim_id": claim_id,
        "outcome": outcome,
        "completeness_score": completeness_score,
        "coverage_status": coverage_status,
        "fraud_risk": fraud_risk,
        "policy_status": "Active" if policy_active else "Inactive",
        "checks": checks,
        "failure_reasons": failure_reasons,
        "new_status": new_status,
        "validation_id": validation_id,
    }

