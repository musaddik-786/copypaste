from pydantic import BaseModel
from typing import Optional, List


class ValidationCheck(BaseModel):
    check: str
    passed: bool
    detail: str


class ValidationGroup(BaseModel):
    category: str
    items: List[ValidationCheck]


class IntakeValidationResponse(BaseModel):
    claim_id: str
    outcome: str                    # "pass" | "fail"
    completeness_score: int
    coverage_status: str            # "Confirmed" | "Not Confirmed"
    fraud_risk: str                 # "Low" | "High"
    policy_status: str              # "Active" | "Inactive"
    checks: List[ValidationGroup]
    failure_reasons: List[str]
    new_status: str                 # status the claim was moved to
    validation_id: str

