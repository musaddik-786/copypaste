─────────────────────────
Replicates the exact triage computation from the Replit app's
POST /api/motor-claims/submit handler (routes.ts lines 5164-5172).

Current implementation: rule-based logic identical to Replit.
Future: swap compute_triage() internals for Qwen 3B SLM call
        without touching anything else in this file or the agent.

Triage logic (verbatim from Replit):
  fraud_risk_score:
    base = 20
    +45 if driver.authorized_driver != "Yes"
    +25 if severity == "Severe" and vehicles_involved <= 1
    +15 if severity == "Severe" and collision_type == "Rear" and no photos
    capped at 100

  complexity:
    Severe   → High
    Moderate → Medium
    Minor    → Low

  routing:
    fraud_risk_score >= 70  → SIU
    complexity == High      → Investigation
    severity == Minor       → Fast Track
    else                    → Standard

On completion → writes to claim_triage table, advances claim status
                to "Loss Investigation".
"""

import logging
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "common"))

from db import get_db_connection, row_to_dict  # noqa: E402

log = logging.getLogger(__name__)


def get_motor_claim_full(claim_id: str) -> dict | None:
    """
    Fetch claim + motor_claim_details + accident_details + driver_details
    for a claim in 'Triage Pending' status.
    Returns None if not found.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()

        cur.execute("SELECT * FROM claims WHERE claim_number = %s", (claim_id,))
        claim = row_to_dict(cur.fetchone())
        if not claim:
            return None

        cur.execute(
            "SELECT * FROM motor_claim_details WHERE claim_id = %s LIMIT 1", (claim_id,)
        )
        motor = row_to_dict(cur.fetchone())

        cur.execute(
            "SELECT * FROM accident_details WHERE claim_id = %s LIMIT 1", (claim_id,)
        )
        accident = row_to_dict(cur.fetchone())

        cur.execute(
            "SELECT * FROM driver_details WHERE claim_id = %s LIMIT 1", (claim_id,)
        )
        driver = row_to_dict(cur.fetchone())

        return {
            "claim": claim,
            "motor": motor or {},
            "accident": accident or {},
            "driver": driver or {},
        }
    finally:
        conn.close()


def poll_triage_pending_claims() -> list[dict]:
    """
    Return all Motor claims currently in 'Triage Pending' status.
    Called by the MotorTriageAgent polling loop.
    """
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute(
            """
            SELECT c.claim_number
            FROM   claims c
            JOIN   motor_claim_details m ON m.claim_id = c.claim_number
            WHERE  c.status = 'Triage Pending'
            ORDER  BY c.filed_at ASC
            """,
        )
        rows = cur.fetchall()
        return [dict(r) for r in rows] if rows else []
    finally:
        conn.close()


def compute_triage(claim_id: str) -> dict:
    """
    Exact replication of the Replit triage scoring (routes.ts lines 5164-5172).

    ── SLM SWAP POINT ──────────────────────────────────────────────────────────
    When the Qwen 3B SLM is ready, replace the rule-based scoring block below
    (marked with # [RULE-BASED]) with a call to the SLM inference function.
    Everything else in this method (DB reads, DB writes, status update) stays
    unchanged.
    ────────────────────────────────────────────────────────────────────────────
    """
    data = get_motor_claim_full(claim_id)
    if not data:
        raise ValueError(f"Motor claim {claim_id} not found or not in Triage Pending status")

    claim    = data["claim"]
    accident = data["accident"]
    driver   = data["driver"]

    severity          = claim.get("severity", "Moderate")
    collision_type    = accident.get("collision_type", "")
    vehicles_involved = accident.get("vehicles_involved", 1) or 1
    authorized_driver = driver.get("authorized_driver", "Yes")
    image_urls        = claim.get("image_urls") or []
    photo_count       = len(image_urls) if isinstance(image_urls, list) else 0

    # [RULE-BASED] ── fraud risk score ────────────────────────────────────────
    fraud_risk_score = 20
    if authorized_driver != "Yes":
        fraud_risk_score += 45
    if severity == "Severe" and vehicles_involved <= 1:
        fraud_risk_score += 25
    if severity == "Severe" and "Rear" in collision_type and photo_count == 0:
        fraud_risk_score += 15
    fraud_risk_score = min(100, fraud_risk_score)

    # [RULE-BASED] ── complexity ──────────────────────────────────────────────
    complexity_map = {"Severe": "High", "Moderate": "Medium", "Minor": "Low"}
    complexity = complexity_map.get(severity, "Medium")

    # [RULE-BASED] ── routing ─────────────────────────────────────────────────
    if fraud_risk_score >= 70:
        routing = "SIU"
    elif complexity == "High":
        routing = "Investigation"
    elif severity == "Minor":
        routing = "Fast Track"
    else:
        routing = "Standard"
    # [RULE-BASED END] ────────────────────────────────────────────────────────

    # ── Write triage result + advance claim status ────────────────────────────
    conn = get_db_connection()
    try:
        cur = conn.cursor()

        # Upsert into claim_triage (replace any row already there for this claim)
        cur.execute(
            """
            INSERT INTO claim_triage (claim_id, damage_severity, complexity, fraud_risk_score, routing)
            VALUES (%s, %s, %s, %s, %s)
            ON CONFLICT DO NOTHING
            """,
            (claim_id, severity, complexity, fraud_risk_score, routing),
        )

        # Advance status → Loss Investigation
        new_status = "Loss Investigation"
        cur.execute(
            "UPDATE claims SET status = %s WHERE claim_number = %s",
            (new_status, claim_id),
        )

        conn.commit()
        log.info(
            "triage claim=%s severity=%s complexity=%s fraud=%s routing=%s → %s",
            claim_id, severity, complexity, fraud_risk_score, routing, new_status,
        )
    except Exception:
        conn.rollback()
        log.exception("triage DB write failed for claim=%s", claim_id)
        raise
    finally:
        conn.close()

    return {
        "claim_id": claim_id,
        "damage_severity": severity,
        "complexity": complexity,
        "fraud_risk_score": fraud_risk_score,
        "routing": routing,
        "new_status": new_status,
    }





